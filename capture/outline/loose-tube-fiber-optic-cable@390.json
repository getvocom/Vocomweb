erent spec? We also build to custom order.","box":{"x":48,"y":996,"w":306,"h":36},"links":[]},{"t":"p","text":"100+","box":{"x":142,"y":1096,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":172,"y":1144,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":124,"y":1212,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":174,"y":1260,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":102,"y":1327,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":175,"y":1375,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":146,"y":1443,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":172,"y":1491,"w":46,"h":16},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/es2S8XiQxHYO7MaYzX1pocRZACg.png?width=1920&height=1080","alt":"Loose-tube outdoor fiber optic cable on a reel","box":{"x":-382,"y":1734,"w":1155,"h":410},"nat":[1155,649]},{"t":"p","text":"What it is","box":{"x":16,"y":2172,"w":358,"h":35},"links":[]},{"t":"p","text":"Loose-tube stranded cable is the workhorse of outside plant. Fibers sit loose in gel-filled tubes stranded around a central member, giving the cable the mechanical and environmental protection outdoor routes demand: duct, aerial or direct-burial. Its all-dielectric, non-metallic construction removes the need for bonding and grounding.","box":{"x":16,"y":2220,"w":358,"h":267},"links":[]},{"t":"p","text":"Construction","box":{"x":38,"y":2534,"w":314,"h":20},"links":[]},{"t":"p","text":"Stranded loose-tube, gel-filled","box":{"x":38,"y":2560,"w":314,"h":20},"links":[]},{"t":"p","text":"Strength member","box":{"x":38,"y":2616,"w":314,"h":20},"links":[]},{"t":"p","text":"Non-metallic (all-dielectric)","box":{"x":38,"y":2642,"w":314,"h":20},"links":[]},{"t":"p","text":"Fiber type","box":{"x":38,"y":2699,"w":314,"h":20},"links":[]},{"t":"p","text":"G.652D single-mode (G.657A1 available)","box":{"x":38,"y":2725,"w":314,"h":20},"links":[]},{"t":"p","text":"Fiber coun