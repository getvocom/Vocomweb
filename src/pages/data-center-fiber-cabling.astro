ewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill-opacity="var(--icon-alpha, 0)" fill="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path><path d="M 0 0 L 9.75 0" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(3.75 12)"></path><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path></svg></a><a class="see-all-fibre-cables-button xaybavg fb" href="/fiber-optic-cables"><p class="xzinndr">See all fiber cables</p></a><a class="x95svpw fb" href="/contact-vocomai"><p class="xzinndr">Talk to a Specifier</p></a></div></div><SpecPanel title={"Build-to-order indoor and outdoor cable"} chips={["MPO and MTP","144F to 864F","OS2, OM3, OM4","Factory terminated"]} note={"Need a different spec? We also build to custom order."} /></div><div class="trust-stats xmtn5ca"><div class="xe1af3r"><p class="x8h4uaa">100+</p><p class="xbgwdly">Regions</p></div><div class="xe1af3r"><p class="x8h4uaa">99.9%</p><p class="xbgwdly">Uptime</p></div><div class="xe1af3r"><p class="x8h4uaa">25,000+</p><p class="xbgwdly">Clients</p></div><div class="xe1af3r"><p class="x8h4uaa">24/7</p><p class="xbgwdly">Support</p></div></div></section><div class="section-divider xbstc8l"><div class="x2h0iev"></div><div class="xqo6eaw"></div><div class="x2h0iev"></div></div><section class="what-it-is xzpblpc"><div class="xafu7qg"><img class="fill-img" src="/assets/img/hero/vc-104-data-center-fiber-connectivity.jpg" srcset="/assets/img/hero/vc-104-data-center-fiber-connectivity-840w.jpg 840w, /assets/img/hero/vc-104-data-center-fiber-connectivity.jpg 1680w" sizes="(max-width: 809.98px) 100vw, 1155px" width="1680" height="944" alt="Data center fiber cabling with MPO trunk cassettes (illustrative render)" loading="lazy" decoding="async" style="object-position:50% 65%"/><span class="render-note">Illustrative render</span></div><div class="section-introduction xpfskxn"><h2 class="xhz5zt5">What it is</h2><p class="xuvmvsv">Everything between the street and the final rack hop is passive. Outside plant cable arrives, gets spliced in the meet-me room from outdoor jacket to plenum or riser rated, and runs as factory-terminated trunk through the main, horizontal and equipment distribution areas. Only at the last hop does an active transceiver appear. Get the passive layer wrong and no transceiver fixes it.</p></div><div class="specification-table xcqzusx fb"><div class="construction-row xcj10xy fb"><p class="xbslay4">Product codes</p><p class="xcclquv">MPO and MTP trunk, LC and SC patch, cassettes and adapters, rollable ribbon ISP</p></div><div class="strength-member-row xcj10xy fb"><p class="xbslay4">Fiber type</p><p class="xcclquv">OS2 single-mode, OM3 and OM4 multimode</p></div><div class="fibre-type-row xcj10xy fb"><p class="xbslay4">Fiber counts</p><p class="xcclquv">12F to 864F, 144F per 1U</p></div><div class="fibre-counts-row xcj10xy fb"><p class="xbslay4">Construction</p><p class="xcclquv">Factory terminated trunk, harness breakout, modular cassette</p></div><div class="sheath-row xcj10xy fb"><p class="xbslay4">Jacket and protection</p><p class="xcclquv">Plenum and riser rated, armored optional, low smoke zero halogen</p></div><div class="deployment-row xcj10xy fb"><p class="xbslay4">Deployment</p><p class="xcclquv">MMR, MDA, HDA, EDA, rack</p></div><div class="standards-row xr2tetp"><p class="xbslay4">Lead time</p><p class="xcclquv">6 to 8 weeks from PO, up to 10 weeks for custom builds, staged delivery available</p></div></div></section><section class="fibre-count-range xqjs4fo"><h2 class="xqmzbdo">Trunk counts and panel density</h2><p class="xbt6gdt">Trunk counts sized to the zone they serve, terminated at the factory so nothing gets spliced on site that does not have to be.</p><div class="count-rail xhrktuh"><div class="12f xvahfb7"><p class="xzxqqpp">12F</p></div><div class="24f xvahfb7"><p class="xzxqqpp">24F</p></div><div class="48f xvahfb7"><p class="xzxqqpp">48F</p></div><div class="96f xvahfb7"><p class="xzxqqpp">96F</p></div><div class="144f xvahfb7"><p class="xzxqqpp">144F</p></div><div class="288f xvahfb7"><p class="xzxqqpp">288F</p></div><div class="576f xvahfb7"><p class="xzxqqpp">576F</p></div><div class="864f xvahfb7"><p class="xzxqqpp">864F</p></div></div></section><div class="section-divider xbstc8l"><div class="x2h0iev"></div><div class="xqo6eaw"></div><div class="x2h0iev"></div></div><div class="individual-products xjpxpkl"><h3 class="xntyyys">Browse individual products</h3><div class="product-links xawjyfv">{products.filter((item) => item.data.category === "Data Center and Indoor Connectivity").map((item) => (<a class="product-link xllccit fb" href={"/products/" + item.id}><p class="x6ieutw">{item.data.name}</p></a>))}</div></div><div class="section-divider xbstc8l"><div class="x2h0iev"></div><div class="xqo6eaw"></div><div class="x2h0iev"></div></div><section class="why-source-through-vocom x6mc4fb"><div class="why-introduction xn9jb0l"><h2 class="x2aydey">Why source it through Vocom</h2></div><div class="sourcing-reason-grid xyelmuz"><div class="build-to-order xwbyhvi fb"><svg class="xmhveue icon" aria-hidden="true" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M 0 2.25 C 0 1.007 1.007 0 2.25 0 C 3.493 0 4.5 1.007 4.5 2.25 C 4.5 3.493 3.493 4.5 2.25 4.5 C 1.007 4.5 0 3.493 0 2.25 Z" fill-opacity="var(--icon-alpha, 0)" fill="var(--icon-color, rgb(0, 0, 0))" transform="translate(7.5 5.25)"></path><path d="M 0 2.25 C 0 1.007 1.007 0 2.25 0 C 3.493 0 4.5 1.007 4.5 2.25 C 4.5 3.493 3.493 4.5 2.25 4.5 C 1.007 4.5 0 3.493 0 2.25 Z" fill-opacity="var(--icon-alpha, 0)" fill="var(--icon-color, rgb(0, 0, 0))" transform="t