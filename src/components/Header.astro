---
// Site header. Replaces the converted Framer "Navigation Bar 2" (which had one menu per breakpoint
// and no route to several pages). Links come from src/lib/nav.ts, so every page is reachable.
// Desktop (>= 1024px): mega menus open on hover or keyboard focus (.has-overlay/.overlay, see
// global.css). Smaller screens: a <details> menu with one expandable section per area, which
// works without JavaScript.
import { NAV } from "../lib/nav";
---
<header class="site-nav" data-nav>
  <a class="sn-logo" href="/" aria-label="Vocom home">
    <img src="/assets/img/og-about-7b6127.png" width="227" height="244" alt="Vocom logo" decoding="async" />
  </a>

  <nav class="sn-menu" aria-label="Main">
    {NAV.map((s) => (
      <div class={`sn-item has-overlay${s.wide ? " sn-wide" : ""}`}>
        <a class="sn-top" href={s.href}>
          {s.label}
          <svg viewBox="0 0 256 256" aria-hidden="true"><path d="M216.49,104.49l-80,80a12,12,0,0,1-17,0l-80-80a12,12,0,0,1,17-17L128,159l71.51-71.52a12,12,0,0,1,17,17Z" /></svg>
        </a>
        <div class="overlay sn-panel">
          {s.groups.map((g) => (
            <div class="sn-group">
              <p class="sn-group-title">{g.title}</p>
              <ul>
                {g.links.map((l) => (
                  <li><a href={l.href}><span class="sn-label">{l.label}</span>{l.desc && <span class="sn-desc">{l.desc}</span>}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <div class="sn-actions">
    <a class="sn-search" href="/search" aria-label="Search products and blog">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
    </a>
    <a class="sn-cta" href="/contact-vocomai">Request a Quote</a>
  </div>

  <details class="sn-mobile">
    <summary aria-label="Menu"><span class="sn-burger" aria-hidden="true"></span></summary>
    <div class="sn-mpanel">
      {NAV.map((s) => (
        <details class="sn-msection">
          <summary>{s.label}</summary>
          {s.groups.map((g) => (
            <div class="sn-mgroup">
              <p class="sn-group-title">{g.title}</p>
              {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          ))}
        </details>
      ))}
      <a class="sn-cta sn-mcta" href="/contact-vocomai">Request a Quote</a>
    </div>
  </details>
</header>

<script is:inline>
  // Hover intent for the desktop menus: an open menu waits before closing, and a neighbouring
  // menu only opens if the pointer stays on it, so moving diagonally to a wide panel works.
  (function () {
    var nav = document.querySelector("[data-nav]");
    if (!nav || !window.matchMedia("(hover: hover)").matches) return;
    nav.classList.add("js-nav");
    var items = nav.querySelectorAll(".sn-item"), openItem = null, closeT, openT;
    function open(it) { if (openItem && openItem !== it) openItem.classList.remove("open"); it.classList.add("open"); openItem = it; }
    // leaving the header (bar and open panel) closes menus straight away
    nav.addEventListener("pointerleave", function () { clearTimeout(closeT); clearTimeout(openT); if (openItem) openItem.classList.remove("open"); openItem = null; });
    items.forEach(function (it) {
      it.addEventListener("pointerenter", function () {
        clearTimeout(closeT); clearTimeout(openT);
        if (!openItem || openItem === it) open(it); else openT = setTimeout(function () { open(it); }, 160);
      });
      it.addEventListener("pointerleave", function () {
        clearTimeout(openT);
        closeT = setTimeout(function () { if (openItem === it) { it.classList.remove("open"); openItem = null; } }, 320);
      });
    });
  })();
</script>

<style>
  .site-nav {
    position: relative; display: flex; align-items: center; gap: 16px; width: 100%;
    padding: 10px 14px 10px 24px; border-radius: 30px; background: var(--white);
    box-shadow: 0 10px 17px -5px rgba(76, 80, 133, 0.2); font-family: var(--font-sans);
  }
  .sn-logo { display: block; flex: none; }
  .sn-logo img { display: block; width: auto; height: 38px; }

  /* desktop menu */
  .sn-menu { display: flex; align-items: center; gap: 2px; margin: 0 auto; }
  .sn-item { position: relative; }
  .sn-item.sn-wide { position: static; }
  .sn-top {
    display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px;
    font-weight: 600; font-size: 15px; line-height: 1.4; color: rgb(14, 28, 41); white-space: nowrap;
  }
  .sn-top svg { width: 14px; height: 14px; fill: var(--brand-crimson); transition: transform 0.15s ease; }
  .sn-item:hover .sn-top, .sn-item:focus-within .sn-top { background: var(--brand-pink-50); }
  .sn-item:hover .sn-top svg, .sn-item:focus-within .sn-top svg { transform: rotate(180deg); }

  .sn-panel {
    position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); z-index: 30;
    gap: 28px; padding: 24px 26px; width: max-content; max-width: min(92vw, 1000px);
    border-radius: 22px; background: var(--white); box-shadow: 0 18px 40px rgba(23, 16, 23, 0.14), 0 0 0 1px rgba(136, 18, 67, 0.08);
    align-items: flex-start;
  }
  .sn-wide .sn-panel { left: 0; right: 0; transform: none; width: auto; max-width: none; }
  .sn-group { min-width: 190px; flex: 1 1 0; }
  .sn-group-title { margin: 0 0 10px; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #8a8a8a; }
  .sn-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .sn-group a { display: flex; flex-direction: column; gap: 1px; padding: 7px 10px; margin: 0 -10px; border-radius: 10px; }
  .sn-group a:hover, .sn-group a:focus-visible { background: var(--brand-pink-50); }
  .sn-label { font-weight: 600; font-size: 14px; line-height: 1.35; color: rgb(14, 28, 41); }
  .sn-group a:hover .sn-label { color: var(--brand-crimson); }
  .sn-desc { font-size: 12.5px; line-height: 1.35; color: #737373; }

  .sn-actions { display: flex; align-items: center; gap: 10px; flex: none; }
  .sn-search { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(14, 28, 41, 0.12); }
  .sn-search svg { width: 18px; height: 18px; fill: none; stroke: rgb(14, 28, 41); stroke-width: 2; stroke-linecap: round; }
  .sn-cta {
    display: inline-flex; align-items: center; padding: 10px 18px; border-radius: 999px;
    background: var(--brand-crimson); color: var(--white); font-weight: 600; font-size: 14px; white-space: nowrap;
  }

  /* phone and tablet menu */
  .sn-mobile { display: none; }
  .sn-mobile > summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; }
  .sn-mobile > summary::-webkit-details-marker { display: none; }
  .sn-burger, .sn-burger::before, .sn-burger::after { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--brand-crimson); transition: transform 0.2s ease, opacity 0.2s ease; }
  .sn-burger { position: relative; }
  .sn-burger::before, .sn-burger::after { content: ""; position: absolute; left: 0; }
  .sn-burger::before { top: -6px; }
  .sn-burger::after { top: 6px; }
  .sn-mobile[open] .sn-burger { background: transparent; }
  .sn-mobile[open] .sn-burger::before { transform: translateY(6px) rotate(45deg); }
  .sn-mobile[open] .sn-burger::after { transform: translateY(-6px) rotate(-45deg); }
  .sn-mpanel {
    position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 30; max-height: calc(100vh - 110px); overflow-y: auto;
    padding: 12px 18px 18px; border-radius: 22px; background: var(--white); box-shadow: 0 18px 40px rgba(23, 16, 23, 0.16);
  }
  .sn-msection { border-bottom: 1px solid rgba(14, 28, 41, 0.08); }
  .sn-msection > summary { list-style: none; cursor: pointer; padding: 14px 4px; font-weight: 700; font-size: 16px; color: rgb(14, 28, 41); display: flex; justify-content: space-between; }
  .sn-msection > summary::-webkit-details-marker { display: none; }
  .sn-msection > summary::after { content: "+"; color: var(--brand-crimson); font-weight: 600; }
  .sn-msection[open] > summary::after { content: "\2212"; }
  .sn-mgroup { display: flex; flex-direction: column; padding: 0 4px 12px; }
  .sn-mgroup .sn-group-title { margin: 6px 0 4px; }
  .sn-mgroup a { padding: 8px 0; font-size: 15px; color: rgb(14, 28, 41); }
  .sn-mcta { margin-top: 16px; justify-content: center; width: 100%; }

  @media (max-width: 1023.98px) {
    .sn-menu, .sn-actions .sn-cta { display: none; }
    .sn-actions { margin-left: auto; }
    .sn-mobile { display: block; }
    .site-nav { padding: 8px 10px 8px 20px; }
    .sn-logo img { height: 34px; }
  }
</style>
