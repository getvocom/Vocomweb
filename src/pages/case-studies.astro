---
// /case-studies: every fiber supply case study on the site in one place (from the homepage
// "Trusted by North American Network Builders" cards and the loose-tube page's "Where it's
// used"), each linked to the products and pages behind it. Client names are not disclosed.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import TradeShowPhoto from "../components/TradeShowPhoto.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductCard from "../components/ProductCard.astro";
import { getProducts } from "../lib/cms";
import { render as getRender, srcset, fallback } from "../lib/renders";

const products = await getProducts();
const p = (id: string) => products.find((x) => x.id === id)!;

const STUDIES = [
  {
    segment: "Open-access fiber operator",
    region: "California, Colorado and Minnesota",
    supplied: "GCYFTY-144 loose-tube and toneable flat-drop cable, supplied build-to-order for multi-state open-access FTTH builds.",
    render: "VC-005",
    products: ["loose-tube-stranded-dielectric", "flat-drop-with-tracing-wire"],
    pages: [["Loose tube fiber optic cable", "/loose-tube-fiber-optic-cable"], ["FTTH drop cable", "/ftth-drop-cable"]],
  },
  {
    segment: "Regional ISP",
    region: "Arizona and California",
    supplied: "Pre-connectorised G657A1 single-fiber drops in 100 to 600ft lengths, plus GCYFTY-144/432 loose-tube and SCA field connectors.",
    render: "VC-012",
    products: ["flat-drop", "loose-tube-stranded-dielectric"],
    pages: [["FTTH drop cable", "/ftth-drop-cable"], ["Loose tube fiber optic cable", "/loose-tube-fiber-optic-cable"]],
  },
  {
    segment: "Municipal broadband",
    region: "Ontario, California",
    supplied: "GCYXTY-24 loose-tube cable sourced for a city-owned fiber network rollout.",
    render: "VC-008",
    products: ["central-tube"],
    pages: [["Loose tube fiber optic cable", "/loose-tube-fiber-optic-cable"]],
  },
  {
    segment: "National broadband footprint",
    region: "23+ US states",
    supplied: "High-count loose-tube from GYFS-864 down to 24F, standardised across regions.",
    render: "VC-007",
    products: ["loose-tube-stranded-dielectric", "high-count-dielectric-ribbon"],
    pages: [["Loose tube fiber optic cable", "/loose-tube-fiber-optic-cable"], ["Ribbon and high fiber count cable", "/ribbon-fiber-optic-cable"]],
  },
];
const sizes = "(max-width: 809.98px) 92vw, 420px";
---
<Base path="/case-studies">
  <div class="cs-page">
    <div class="site-header-slot header-slot" data-pagefind-ignore><Header /></div>
    <main class="cs-main">
      <Breadcrumbs items={[["Home", "/"], ["Case Studies", "/case-studies"]]} />
      <header class="cs-hero">
        <p class="cs-eyebrow">Case studies</p>
        <h1>Fiber Optic Cable Supply Case Studies</h1>
        <p class="cs-lead">From open-access FTTH to municipal broadband, operators across the US and Canada source their outdoor and drop cable through Vocom: specified, build-to-order, and delivered to site.</p>
        <p class="cs-note">We don't disclose client names, but here are a few examples of the work we've delivered.</p>
      </header>

      {STUDIES.map((s, i) => {
        const r = getRender(s.render)!;
        return (
          <article class="cs-study" id={`case-${i + 1}`}>
            <div class="cs-img">
              <picture>
                <source type="image/webp" srcset={srcset(r, "webp")} sizes={sizes} />
                <img src={fallback(r)} srcset={srcset(r, "jpg")} sizes={sizes} width={r.width} height={r.height} alt={`Cable supplied for a ${s.segment.toLowerCase()} build (illustrative render)`} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
              </picture>
              <span class="render-note">Illustrative render</span>
            </div>
            <div class="cs-body">
              <p class="cs-region">{s.region}</p>
              <h2>{s.segment}</h2>
              <p class="cs-supplied">{s.supplied}</p>
              <p class="cs-more">More on: {s.pages.map(([label, href], j) => <>{j > 0 && ", "}<a href={href}>{label}</a></>)}</p>
              <p class="cs-sub">Products supplied</p>
              <div class="cs-products">{s.products.map((id) => <ProductCard item={p(id)} />)}</div>
            </div>
          </article>
        );
      })}

      <TradeShowPhoto heading="Meet the Team Behind the Supply" /><section class="cs-cta">
        <h2>Need Cable for a Similar Build?</h2>
        <p>Send your route, fiber count and needed-by date and we will size it.</p>
        <a class="cs-btn" href="/contact-vocomai">Request a Quote</a>
      </section>
    </main>
    <div class="footer-slot" data-pagefind-ignore><Footer /></div>
  </div>
</Base>

<style>
  .cs-page { display: flex; flex-direction: column; align-items: center; gap: 32px; padding-top: 10px; background: linear-gradient(180deg, var(--brand-pink-50), var(--white) 520px); }
  .cs-main { width: 100%; max-width: 1160px; padding: 0 24px; display: flex; flex-direction: column; gap: 40px; }
  .cs-hero { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .cs-eyebrow { font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand-crimson); }
  .cs-hero h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 5vw, 56px); line-height: 1.05; letter-spacing: -0.03em; color: var(--ink-900); }
  .cs-lead { font-size: 18px; line-height: 1.55; color: #3c3c3c; }
  .cs-note { font-size: 14px; color: #6b6b6b; }
  .cs-study { display: grid; grid-template-columns: 420px 1fr; gap: 32px; padding: 24px; border-radius: 28px; background: var(--white); box-shadow: inset 0 0 0 1px rgba(136, 18, 67, 0.14); }
  .cs-img { position: relative; aspect-ratio: 1; border-radius: 20px; overflow: hidden; background: #e9e8e6; align-self: start; }
  .cs-img picture, .cs-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cs-body { display: flex; flex-direction: column; gap: 10px; }
  .cs-region { font-weight: 600; font-size: 13px; color: var(--brand-crimson); }
  .cs-body h2 { font-family: var(--font-display); font-weight: 800; font-size: 28px; letter-spacing: -0.02em; color: var(--ink-900); }
  .cs-supplied { font-size: 16px; line-height: 1.55; color: #3c3c3c; }
  .cs-more { font-size: 14px; color: #4a4a4a; }
  .cs-more a { color: var(--brand-crimson); text-decoration: underline; text-underline-offset: 2px; }
  .cs-sub { margin-top: 8px; font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: #6b6b6b; }
  .cs-products { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; align-items: stretch; }
  .cs-cta { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 24px; border-radius: 28px; text-align: center; background: var(--brand-pink-50); }
  .cs-cta h2 { font-family: var(--font-display); font-weight: 800; font-size: 30px; color: var(--ink-900); }
  .cs-btn { margin-top: 6px; padding: 12px 22px; border-radius: 999px; background: var(--brand-crimson); color: var(--white); font-weight: 600; }
  @media (max-width: 1023.98px) { .cs-study { grid-template-columns: 1fr; } .cs-img { aspect-ratio: 16 / 10; } }
  @media (max-width: 809.98px) { .cs-main { padding: 0 16px; } .cs-study { padding: 16px; } .cs-products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
