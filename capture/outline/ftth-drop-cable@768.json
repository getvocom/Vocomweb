[{"t":"a","href":"./","text":"","box":{"x":36,"y":22,"w":50,"h":40}},{"t":"img","src":"https://framerusercontent.com/images/93Dhh8MlhJlV2Fnjh3zQ7n2fM.png?width=227&height=244","alt":"Vocom logo","box":{"x":45,"y":24,"w":33,"h":35},"nat":[227,244]},{"t":"p","text":"☰","box":{"x":705,"y":28,"w":21,"h":29},"links":[]},{"t":"svg","w":16},{"t":"p","text":"Indoor and outdoor fiber cable supply","box":{"x":52,"y":131,"w":248,"h":14},"links":[]},{"t":"p","text":"FTTH Drop Cable, Connectors and Terminal Boxes","box":{"x":16,"y":172,"w":736,"h":80},"links":[]},{"t":"p","text":"Flat drop with and without tracing wire, armored drop in NSS and SS, low-visibility indoor cable and OptiTap compatible IP68 field connectors. Sourced build-to-order by the reel and delivered in 6 to 8 weeks from PO, up to 10 weeks for custom builds.","box":{"x":16,"y":270,"w":736,"h":74},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Request a Quote","box":{"x":16,"y":362,"w":736,"h":45}},{"t":"p","text":"Request a Quote","box":{"x":310,"y":377,"w":122,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./fiber-optic-cables","text":"Reorder a Previous Spec","box":{"x":16,"y":419,"w":736,"h":43}},{"t":"p","text":"Reorder a Previous Spec","box":{"x":294,"y":433,"w":180,"h":15},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":16,"y":474,"w":172,"h":43}},{"t":"p","text":"Talk to a Specifier","box":{"x":36,"y":488,"w":132,"h":15},"links":[]},{"t":"p","text":"Build-to-order indoor and outdoor cable","box":{"x":94,"y":569,"w":638,"h":27},"links":[]},{"t":"p","text":"Flat and armored drop","box":{"x":36,"y":623,"w":696,"h":14},"links":[]},{"t":"p","text":"1F to 12F","box":{"x":36,"y":661,"w":696,"h":14},"links":[]},{"t":"p","text":"G.657A1 and A2","box":{"x":36,"y":699,"w":696,"h":14},"links":[]},{"t":"p","text":"IP68 connectors","box":{"x":36,"y":737,"w":696,"h":14},"links":[]},{"t":"p","text":"Need a different spec? We also build to custom order.","box":{"x":48,"y":769,"w":684,"h":18},"links":[]},{"t":"p","text":"100+","box":{"x":331,"y":851,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":361,"y":899,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":313,"y":967,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":363,"y":1015,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":291,"y":1083,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":364,"y":1131,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":335,"y":1198,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":361,"y":1246,"w":46,"h":16},"links":[]},{"t":"p","text":"What it is","box":{"x":16,"y":1489,"w":736,"h":35},"links":[]},{"t":"p","text":"The drop is the last hundred feet and the part that gets touched most. It runs an aerial span, down a wall, through an entry point and into a room, so it needs to bend tighter than outside plant cable ever does and survive being handled by a crew working fast. Bend spec and termination method decide the labor cost per drop, which is the number that actually matters at volume.","box":{"x":16,"y":1537,"w":736,"h":149},"links":[]},{"t":"p","text":"Product codes","box":{"x":38,"y":1732,"w":692,"h":20},"links":[]},{"t":"p","text":"Flat drop, flat drop with tracing wire, armored drop NSS and SS, FTTR low-visibility, GYFXBTC8F","box":{"x":38,"y":1758,"w":692,"h":20},"links":[]},{"t":"p","text":"Fiber type","box":{"x":38,"y":1814,"w":692,"h":20},"links":[]},{"t":"p","text":"G.657A1 and G.657.A2 bend-insensitive, G.657.B3 available","box":{"x":38,"y":1841,"w":692,"h":20},"links":[]},{"t":"p","text":"Fiber counts","box":{"x":38,"y":1897,"w":692,"h":20},"links":[]},{"t":"p","text":"1F to 12F","box":{"x":38,"y":1923,"w":692,"h":20},"links":[]},{"t":"p","text":"Construction","box":{"x":38,"y":1979,"w":692,"h":20},"links":[]},{"t":"p","text":"Flat drop, spiral armored, round in and outdoor","box":{"x":38,"y":2006,"w":692,"h":20},"links":[]},{"t":"p","text":"Jacket and protection","box":{"x":38,"y":2062,"w":692,"h":20},"links":[]},{"t":"p","text":"Rodent resistant armor, UV stable, indoor and outdoor rated","box":{"x":38,"y":2088,"w":692,"h":20},"links":[]},{"t":"p","text":"Deployment","box":{"x":38,"y":2144,"w":692,"h":20},"links":[]},{"t":"p","text":"Aerial span, duct, wall entry, in-home and FTTR","box":{"x":38,"y":2171,"w":692,"h":20},"links":[]},{"t":"p","text":"Lead time","box":{"x":38,"y":2227,"w":692,"h":20},"links":[]},{"t":"p","text":"6 to 8 weeks from PO, up to 10 weeks for custom builds","box":{"x":38,"y":2253,"w":692,"h":20},"links":[]},{"t":"p","text":"Counts and variants","box":{"x":34,"y":2397,"w":700,"h":35},"links":[]},{"t":"p","text":"Standard drop counts, with and without tracing wire, pre-connectorized or supplied for field termination.","box":{"x":34,"y":2460,"w":700,"h":56},"links":[]},{"t":"p","text":"1F","box":{"x":197,"y":2558,"w":20,"h":20},"links":[]},{"t":"p","text":"2F","box":{"x":549,"y":2558,"w":24,"h":20},"links":[]},{"t":"p","text":"4F","box":{"x":194,"y":2616,"w":25,"h":20},"links":[]},{"t":"p","text":"8F","box":{"x":549,"y":2616,"w":24,"h":20},"links":[]},{"t":"p","text":"12F","box":{"x":190,"y":2674,"w":32,"h":20},"links":[]},{"t":"p","text":"Browse individual products","box":{"x":16,"y":2871,"w":736,"h":26},"links":[]},{"t":"a","href":"./products/flat-drop","text":"Flat drop","box":{"x":77,"y":2915,"w":84,"h":36}},{"t":"p","text":"Flat drop","box":{"x":91,"y":2925,"w":56,"h":16},"links":[]},{"t":"a","href":"./products/flat-drop-with-tracing-wire","text":"Flat drop with tracing wire","box":{"x":171,"y":2915,"w":193,"h":36}},{"t":"p","text":"Flat drop with tracing wire","box":{"x":185,"y":2925,"w":165,"h":16},"links":[]},{"t":"a","href":"./products/armored-indoor-drop","text":"Armored indoor drop","box":{"x":373,"y":2915,"w":160,"h":36}},{"t":"p","text":"Armored indoor drop","box":{"x":387,"y":2925,"w":132,"h":16},"links":[]},{"t":"a","href":"./products/mini-cable-plenum","te