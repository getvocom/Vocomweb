---
// HTML sitemap (Tom, 2026-11-24): every page, product and blog post, linked from the footer.
// Built from src/lib/static-pages.ts (same groups as /llms.txt), the nav labels and the
// content collections, so new pages, products and posts appear automatically. Page names
// are the nav label, or the page's own <title> without "| Vocom" when it isn't in the nav.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { NAV } from "../lib/nav";
import { SECTIONS } from "../lib/static-pages";
import { headFor } from "../lib/head";
import { getPosts, getProducts } from "../lib/cms";

const navLabel = new Map<string, string>();
for (const s of NAV) { navLabel.set(s.href, s.label); for (const g of s.groups) for (const l of g.links) if (!navLabel.has(l.href)) navLabel.set(l.href, l.label); }
const name = (p: string) => p === "/" ? "Home" : navLabel.get(p) ?? headFor(p).title.replace(/\s*\|\s*Vocom.*$/, "");
const groups = [["Home", ["/"]] as [string, string[]], ...SECTIONS].map(([title, paths]) => ({ title, links: paths.map((p) => ({ href: p, label: name(p) })) }));

const products = await getProducts();
const categories = [...new Set(products.map((p) => p.data.category))];
const posts = (await getPosts()).slice().sort((a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0));
---
<Base path="/sitemap">
  <div class="sm-page">
    <div class="site-header-slot"><Header /></div>
    <main class="sm-main">
      <h1>Sitemap</h1>
      <p class="sm-lede">Every page on vocom.ai. Looking for something specific? Try <a href="/search">search</a> or <a href="/contact-vocomai">ask the team</a>.</p>
      <div class="sm-grid">
        {groups.map((g) => (
          <section class="sm-group">
            <h2>{g.title}</h2>
            <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </section>
        ))}
      </div>
      <h2 class="sm-heading">Products</h2>
      <div class="sm-grid">
        {categories.map((c) => (
          <section class="sm-group">
            <h3>{c}</h3>
            <ul>{products.filter((p) => p.data.category === c).map((p) => <li><a href={"/products/" + p.id}>{p.data.name}</a></li>)}</ul>
          </section>
        ))}
      </div>
      <h2 class="sm-heading">Blog</h2>
      <ul class="sm-posts">{posts.map((p) => <li><a href={"/blog/" + p.id}>{p.data.cardTitle ?? p.data.title}</a></li>)}</ul>
    </main>
    <div class="sm-footer"><Footer /></div>
  </div>
</Base>

<style>
  .sm-page { display: flex; flex-direction: column; align-items: center; min-height: 100vh; background: var(--white); }
  .sm-main { width: 100%; max-width: 1200px; padding: 120px 24px 64px; font-family: var(--font-sans); color: var(--ink-heading); }
  .sm-main h1 { font-family: var(--font-display); font-weight: 800; font-size: 56px; line-height: 1.08; letter-spacing: -0.04em; }
  .sm-lede { margin-top: 12px; font-size: 17px; line-height: 1.55; color: var(--gray-600); }
  .sm-lede a, .sm-main ul a { text-underline-offset: 2px; }
  .sm-lede a { text-decoration: underline; }
  .sm-heading { margin-top: 56px; font-family: var(--font-display); font-weight: 700; font-size: 32px; letter-spacing: -0.02em; }
  .sm-grid { margin-top: 28px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
  .sm-group h2, .sm-group h3 { margin-bottom: 12px; font-weight: 700; font-size: 16px; }
  .sm-main ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sm-main ul a { font-size: 15px; line-height: 1.4; color: var(--gray-600); }
  .sm-main ul a:hover { color: var(--brand-crimson); text-decoration: underline; }
  .sm-posts { margin-top: 20px; columns: 2; column-gap: 24px; display: block !important; }
  .sm-posts li { margin-bottom: 8px; break-inside: avoid; }
  .sm-footer { width: 100%; }
  @media (max-width: 1199.98px) { .sm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 809.98px) {
    .sm-main { padding: 96px 20px 48px; }
    .sm-main h1 { font-size: 40px; }
    .sm-heading { font-size: 26px; margin-top: 44px; }
    .sm-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .sm-posts { columns: 1; }
  }
</style>
