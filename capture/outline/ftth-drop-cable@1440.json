[{"t":"a","href":"./","text":"","box":{"x":252,"y":23,"w":76,"h":40}},{"t":"img","src":"https://framerusercontent.com/images/93Dhh8MlhJlV2Fnjh3zQ7n2fM.png?width=227&height=244","alt":"Vocom logo","box":{"x":274,"y":25,"w":33,"h":35},"nat":[227,244]},{"t":"p","text":"Fiber Optic","box":{"x":350,"y":30,"w":85,"h":26},"links":["./fiber-optic-cables"]},{"t":"svg","w":20},{"t":"p","text":"Vocom AI","box":{"x":505,"y":30,"w":78,"h":26},"links":["./vocom-ai"]},{"t":"svg","w":20},{"t":"p","text":"Vocom International","box":{"x":653,"y":30,"w":159,"h":26},"links":["./vocom-international"]},{"t":"svg","w":20},{"t":"p","text":"About","box":{"x":882,"y":30,"w":47,"h":26},"links":["./about"]},{"t":"svg","w":20},{"t":"a","href":"./search","text":"🔍","box":{"x":981,"y":23,"w":40,"h":40}},{"t":"p","text":"🔍","box":{"x":991,"y":34,"w":20,"h":19},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Request a Quote","box":{"x":1037,"y":22,"w":151,"h":42}},{"t":"p","text":"Request a Quote","box":{"x":1057,"y":32,"w":111,"h":22},"links":[]},{"t":"svg","w":16},{"t":"p","text":"Indoor and outdoor fiber cable supply","box":{"x":176,"y":159,"w":248,"h":14},"links":[]},{"t":"h1","text":"FTTH Drop Cable, Connectors and Terminal Boxes","box":{"x":140,"y":204,"w":564,"h":202},"links":[]},{"t":"p","text":"Flat drop with and without tracing wire, armored drop in NSS and SS, low-visibility indoor cable and OptiTap compatible IP68 field connectors. Sourced build-to-order by the reel and delivered in 6 to 8 weeks from PO, up to 10 weeks for custom builds.","box":{"x":140,"y":428,"w":564,"h":147},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Request a Quote","box":{"x":140,"y":597,"w":192,"h":45}},{"t":"p","text":"Request a Quote","box":{"x":162,"y":612,"w":122,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./fiber-optic-cables","text":"Reorder a Previous Spec","box":{"x":344,"y":598,"w":220,"h":43}},{"t":"p","text":"Reorder a Previous Spec","box":{"x":364,"y":612,"w":180,"h":15},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":140,"y":654,"w":172,"h":43}},{"t":"p","text":"Talk to a Specifier","box":{"x":160,"y":668,"w":132,"h":15},"links":[]},{"t":"h2","text":"Build-to-order indoor and outdoor cable","box":{"x":818,"y":184,"w":458,"h":27},"links":[]},{"t":"p","text":"Flat and armored drop","box":{"x":760,"y":238,"w":246,"h":14},"links":[]},{"t":"p","text":"1F to 12F","box":{"x":1030,"y":238,"w":246,"h":14},"links":[]},{"t":"p","text":"G.657A1 and A2","box":{"x":760,"y":276,"w":246,"h":14},"links":[]},{"t":"p","text":"IP68 connectors","box":{"x":1030,"y":276,"w":246,"h":14},"links":[]},{"t":"p","text":"Need a different spec? We also build to custom order.","box":{"x":772,"y":308,"w":504,"h":18},"links":[]},{"t":"p","text":"100+","box":{"x":227,"y":751,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":257,"y":799,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":503,"y":751,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":553,"y":799,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":774,"y":751,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":847,"y":799,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":1111,"y":751,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":1137,"y":799,"w":46,"h":16},"links":[]},{"t":"h2","text":"What it is","box":{"x":140,"y":1080,"w":1160,"h":45},"links":[]},{"t":"p","text":"The drop is the last hundred feet and the part that gets touched most. It runs an aerial span, down a wall, through an entry point and into a room, so it needs to bend tighter than outside plant cable ever does and survive being handled by a crew working fast. Bend spec and termination method decide the labor cost per drop, which is the number that actually matters at volume.","box":{"x":140,"y":1139,"w":1160,"h":89},"links":[]},{"t":"p","text":"Product codes","box":{"x":162,"y":1274,"w":558,"h":20},"links":[]},{"t":"p","text":"Flat drop, flat drop with tracing wire, armored drop NSS and SS, FTTR low-visibility, GYFXBTC8F","box":{"x":720,"y":1274,"w":558,"h":41},"links":[]},{"t":"p","text":"Fiber type","box":{"x":162,"y":1351,"w":558,"h":20},"links":[]},{"t":"p","text":"G.657A1 and G.657.A2 bend-insensitive, G.657.B3 available","box":{"x":720,"y":1351,"w":558,"h":20},"links":[]},{"t":"p","text":"Fiber counts","box":{"x":162,"y":1407,"w":558,"h":20},"links":[]},{"t":"p","text":"1F to 12F","box":{"x":720,"y":1407,"w":558,"h":20},"links":[]},{"t":"p","text":"Construction","box":{"x":162,"y":1463,"w":558,"h":20},"links":[]},{"t":"p","text":"Flat drop, spiral armored, round in and outdoor","box":{"x":720,"y":1463,"w":558,"h":20},"links":[]},{"t":"p","text":"Jacket and protection","box":{"x":162,"y":1520,"w":558,"h":20},"links":[]},{"t":"p","text":"Rodent resistant armor, UV stable, indoor and outdoor rated","box":{"x":720,"y":1520,"w":558,"h":20},"links":[]},{"t":"p","text":"Deployment","box":{"x":162,"y":1576,"w":558,"h":20},"links":[]},{"t":"p","text":"Aerial span, duct, wall entry, in-home and FTTR","box":{"x":720,"y":1576,"w":558,"h":20},"links":[]},{"t":"p","text":"Lead time","box":{"x":162,"y":1632,"w":558,"h":20},"links":[]},{"t":"p","text":"6 to 8 weeks from PO, up to 10 weeks for custom builds","box":{"x":720,"y":1632,"w":558,"h":20},"links":[]},{"t":"h2","text":"Counts and variants","box":{"x":176,"y":1814,"w":1088,"h":45},"links":[]},{"t":"p","text":"Standard drop counts, with and without tracing wire, pre-connectorized or supplied for field termination.","box":{"x":340,"y":1888,"w":760,"h":56},"links":[]},{"t":"p","text":"1F","box":{"x":271,"y":1986,"w":20,"h":20},"links":[]},{"t":"p","text":"2F","box":{"x":488,"y":1986,"w":24,"h":20},"links":[]},{"t":"p","text":"4F","box":{"x":707,"y":1986,"w":25,"h":20},"links":[]},{"t":"p","text":"8F","box":{"x":927,"y":1986,"w":24,"h":20},"links":[]},{"t":"p","text":"12F","box":{"x":1143,"y":1986,"w":32,"h":20},"links":[]},{"