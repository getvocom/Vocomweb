<div data-pagefind-body class="desktop xi0ewwc"><div class="navigation-bar-2 x13ffoj header-slot" data-pagefind-ignore><Header /></div><section class="product-content xsvqzfg"><p class="xyuew4q"><a href="/fiber-optic-cable-catalog">FULL PRODUCT CATALOG</a></p><div class="xh6i4ui rt"></div><h1 class="x0u8dvb">{entry.data.name}</h1><div class="product-image x2af2jo fb">{entry.data.image?.src && <img class="fill-img" src={entry.data.image.src} alt={entry.data.image.alt ?? ""} loading="lazy" decoding="async"/>}</div><p class="xzcsama">{entry.data.description}</p><div class="buttons x50ehlf"><a class="request-a-quote-button x2urddb" href="/contact-vocomai"><p class="xvkflym">Request a Quote</p><svg class="xquoydi icon" aria-hidden="true" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill-opacity="var(--icon-alpha, 0)" fill="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path><path d="M 0 0 L 9.75 0" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(3.75 12)"></path><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path></svg></a><a class="back-to-catalog-button x95svpw fb" href="/fiber-optic-cable-catalog"><p class="xzinndr">Back to full catalog</p></a></div><div class="spec-grid xxrqjzt"><div class="codes xcuaa1w fb"><p class="xnj14gm">Codes</p><p class="x44ez2f">{entry.data.codes}</p></div><div class="fiber-counts xcuaa1w fb"><p class="xnj14gm">Fiber Counts</p><p class="x44ez2f">{entry.data.fiberCounts}</p></div><div class="construction-and-rating xcuaa1w fb"><p class="xnj14gm">Construction and Rating</p><p class="x44ez2f">{entry.data.construction}</p></div><div class="typical-use xcuaa1w fb"><p class="xnj14gm">Typical Use</p><p class="x44ez2f">{entry.data.typicalUse}</p></div></div></section><section class="xwcnuxb"><p class="xbu318r">Frequently Asked Questions</p><p class="x6a76mt">Straight answers about this cable.</p><div class="xvjdqmp"><div class="faq-accordian-item-2 xzkh4c6"><FaqItem question="What fiber counts does this cable come in?">{entry.data.fiberCounts}</FaqItem></div><div class="faq-accordian-item-2 xzkh4c6"><FaqItem question="What is it built and rated to?">{entry.data.construction}</FaqItem></div><div class="faq-accordian-item-2 xzkh4c6"><FaqItem question="Where is this cable typically used?">{entry.data.typicalUse}</FaqItem></div><div class="faq-accordian-item-2 xzkh4c6"><FaqItem question="What product codes does it ship under?">{entry.data.codes}</FaqItem></div></div></section><section class="related-products x9qoodp"><h2 class="x37z6xf">More from this category</h2><div class="xh6i4ui rt"></div><div class="related-product-links xawjyfv">{products.filter((item1) => item1.data.category === entry.data.category).slice(0, 4).map((item1) => (<a class="related-product-link xllccit fb" href={"/products/" + item1.id}><p class="x6ieutw">{item1.data.name}</p></a>))}</div><div class="explore-more xbunreh"><p class="xrd9vq3"><a href="/fiber-optic-cable-catalog">View the full product catalog</a></p><p class="xrd9vq3"><a href="/fiber-optic-cables">See our full fiber optic cable range</a></p><p class="xrd9vq3"><a href="/contact-vocomai">Talk to a specifier</a></p></div></section><div class="closing-cta xncr0wo fb"><h2 class="x1ms1st">Need a quote on this cable?</h2><a class="request-a-quote-button x2urddb" href="/contact-vocomai"><p class="xvkflym">Request a Quote</p><svg class="xquoydi icon" aria-hidden="true" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill-opacity="var(--icon-alpha, 0)" fill="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path><path d="M 0 0 L 9.75 0" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(3.75 12)"></path><path d="M 0 0 L 6.75 6.75 L 0 13.5 Z" fill="transparent" stroke-dasharray="" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke, 1.5)" stroke="var(--icon-color, rgb(0, 0, 0))" transform="translate(13.5 5.25)"></path></svg></a></div><div class="simple-footer-2 xzxrxrs footer-slot" data-pagefind-ignore><Footer footerTagline="Your partner for telecommunications and fiber optic supply." title="Quick Links" menu1="VOCOM AI" menu2="Services" menu3="RenOS AI Agents" link2="/vocom-services" link3="/vocom-ai-agents" /></div></div>
</Base>
