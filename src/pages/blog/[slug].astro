}
const { entry } = Astro.props;
const path = "/blog/" + entry.id;
const seo = blogSeo(path, entry);
const posts = await getPosts();
// Bodies are plain text; [label](/path) or [label](https://www.vocom.ai/path) becomes a link.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const rich = (t?: string) => esc(t ?? "").replace(/\[([^\]]+)\]\(((?:https:\/\/www\.vocom\.ai)?\/[^)\s"]*)\)/g, (_, label, href) => `<a href="${href.replace("https://www.vocom.ai", "")}">${label}</a>`);
