h-supply-logo-98e806-512w.webp 512w, /assets/img/american-tech-supply-logo-98e806.png 711w" sizes="(min-width: 810px) and (max-width: 1199.98px) 100vw, (max-width: 809.98px) 100vw, 100vw" width="711" height="104" alt="American Tech Supply logo" loading="lazy" decoding="async"/></div><div class="wesco x2anvzu"><img class="fill-img" src="/assets/img/wesco-logo-vocom-fiber-optic-supply-chain-partner-f1eba4.png" srcset="/assets/img/wesco-logo-vocom-fiber-optic-supply-chain-partner-f1eba4-512w.webp 512w, /assets/img/wesco-logo-vocom-fiber-optic-supply-chain-partner-f1eba4.png 559w" sizes="(min-width: 810px) and (max-width: 1199.98px) 100vw, (max-width: 809.98px) 100vw, 100vw" width="559" height="357" alt="" loading="lazy" decoding="async"/></div><div class="logo-optech"><img class="fill-img" src="/assets/img/optech-logo-vocom-fiber-partner.png" width="233" height="80" alt="Optech logo" loading="lazy" decoding="async"/></div></div></div></div><div class="xoopqlt"><div class="form xbbzkyj"><form class="xu9kdxu quote-step-1" data-next="quote-step-2"><label class="xg7mvzh"><p class="xcoxzmw">Name</p><input class="xswvwdz field" type="text" name="Name" placeholder="Your Name" required/></label><label class="xg7mvzh"><p class="xcoxzmw">Email</p><input class="xswvwdz field" type="email" name="Email" placeholder="Your work email" autocomplete="email" required/></label><label class="xguavky"><p class="xcoxzmw">Company Name</p><textarea class="xlz9z7n field" name="Company " placeholder="Your Company " required></textarea></label><label class="xg7mvzh"><p class="xcoxzmw">Use case </p><select class="xswvwdz field" name="Use Case" required><option value="" disabled>Select…</option><option value="Fiber Optic">Fiber Optic</option><option value="Consultancy">Consultancy</option><option value="RenOS">RenOS</option><option value="AI Server Rental ">AI Server Rental </option><option value="Custom Solution">Custom Solution</option><option value="Other">Other</option></select></label><label class="xg7mvzh"><p class="xcoxzmw">What do you need?</p><textarea class="xpz8r3t field" name="Message" placeholder="e.g. 144F single-mode outdoor cable, about 24,000 ft, delivered to Texas" required></textarea></label><label class="xobjyy4"><input class="xaslpal field" type="text" name="Website"/></label><label class="xobjyy4"><input class="xaslpal field" type="text" name="Phone Number"/></label><label class="xobjyy4"><input class="xaslpal field" type="text" name="Fax"/></label><label class="xobjyy4"><input class="xaslpal field" type="text" name="Address"/></label><div class="button-5 x7ebm6z"><SubmitButton /></div><p class="form-next">Have a full spec or bill of materials? You can add it on the next screen.</p></form><form class="xu9kdxu quote-step-2" id="quote-step-2" data-endpoint={FORMS_URL} hidden><div class="step-head"><p class="step-title">Thanks, we have your request.</p><p class="step-body">Add your full spec now for a faster, more accurate quote. Everything here is optional.</p></div><label class="xg7mvzh"><p class="xcoxzmw">I am a</p><select class="xswvwdz field" name="I Am A"><option value="">Select…</option><option value="Distributor or reseller">Distributor or reseller</option><option value="Installation contractor">Installation contractor</option><option value="Carrier or ISP">Carrier or ISP</option><option value="Data center builder or operator">Data center builder or operator</option><option value="Referral partner">Referral partner</option><option value="Other">Other</option></select></label><label class="xg7mvzh"><p class="xcoxzmw">Company Size</p><select class="xswvwdz field" name="Company Size"><option value="">Select…</option><option value="1-50">1-50</option><option>51-249</option><option value="250-500">250-500</option><option value="500-1000">500-1000</option><option value="1000+">1000+</option></select></label><div class="fiber-fields" data-show-when="Fiber Optic" hidden><label class="xg7mvzh"><p class="xcoxzmw">Fiber count</p><input class="xswvwdz field" type="text" name="Fiber Count" placeholder="e.g. 144F" disabled/></label><label class="xg7mvzh"><p class="xcoxzmw">Fiber type</p><select class="xswvwdz field" name="Fiber Type" disabled><option value="">Select…</option><option>Single-mode (OS2)</option><option>Multimode (OM3, OM4 or OM5)</option><option>Not sure</option></select></label><label class="xg7mvzh"><p class="xcoxzmw">Rating</p><select class="xswvwdz field" name="Rating" disabled><option value="">Select…</option><option>Outdoor OSP</option><option>Aerial (ADSS)</option><option>Indoor plenum (OFNP)</option><option>Indoor riser (OFNR)</option><option>LSZH</option><option>Not sure</option></select></label><label class="xg7mvzh"><p class="xcoxzmw">Footage / length</p><input class="xswvwdz field" type="text" name="Footage" placeholder="e.g. 4 reels of 12,000 ft, or 48,000 ft total" disabled/></label><label class="xg7mvzh"><p class="xcoxzmw">Delivery state / country</p><input class="xswvwdz field" type="text" name="Delivery Location" placeholder="e.g. Texas, USA" autocomplete="address-level1" disabled/></label><label class="xg7mvzh"><p class="xcoxzmw">Needed by</p><input class="xswvwdz field" type="date" name="Needed By" disabled/></label></div><label class="xg7mvzh"><p class="xcoxzmw">Requirements spreadsheet (optional)</p><input class="xswvwdz field file-field" type="file" name="Requirements File" accept=".xlsx,.xls,.csv,.pdf"/><span class="field-help">Excel, CSV or PDF, up to 10 MB. Useful for multi-line orders or full bills of materials.</span></label><input type="hidden" name="Use Case"/><p class="form-msg" role="alert" hidden></p><div class="step-actions"><button type="submit" class="details-btn">Add details</button><a class="details-skip" href="/resources">Skip</a></div><p class="form-next">What happens next: we review your requirements and reply by email with pricing, lead time and any questions about the spec.</p><div class="step-links"><a class="step-link" href="https://drive.google.com/drive/folders/1Z-fUh05kchJa-yp29QmTjHUIbLH5mSau?usp=sharing" target="_blank" rel="noopener"><span class="step-link-title">Fiber Optic Cable Catalog</span><span class="step-link-body">Loose-tube, drop and ADSS cable: counts, specs and how to order build-to-order.</span><span class="step-link-cta">Access Our Catalog Here</span></a><a class="step-link" href="https://calendly.com/kevin-getvocom" target="_blank" rel="noopener"><span class="step-link-title">Prefer to talk? Book a call.</span><span class="step-link-body">Choose a time with the Vocom team and we’ll walk through fiber, connectivity or AI options for your project.</span><span class="step-link-cta">Book a call</span></a></div></form></div></div></div><div class="xsdjazi"></div><div class="simple-footer-2 xzxrxrs footer-slot" data-pagefind-ignore><Footer footerTagline="One Platform. One Partner. Future-Ready" title="Quick Links" menu1="VOCOM" menu2="Services" menu3="RenOS AI Agents" link1="/" link2="/vocom-services" link3="/vocom-ai-agents" /></div></div>
<script is:inline>
  // Two-step quote form. Step 1 (short) is sent by SubmitButton, which fires the Ads conversion.
  // When the script confirms the save it raises "quote-step-2" with the lead id; step 2 (the full
  // spec, all optional) then replaces step 1 and adds to the same row in the Quotes sheet.
  // Step 2 never fires a conversion. Fiber questions appear only when Use Case was "Fiber Optic";
  // hidden questions are disabled so they are not submitted.
  (function () {
    var one = document.querySelector(".quote-step-1"), two = document.getElementById("quote-step-2");
    if (!one || !two) return;
    var box = two.querySelector(".fiber-fields"), btn = two.querySelector(".details-btn"), msg = two.querySelector(".form-msg");
    var id = "";
    function say(t) { msg.textContent = t; msg.hidden = !t; }
    window.addEventListener("quote-step-2", function (e) {
      id = e.detail.id;
      var use = (one.querySelector('[name="Use Case"]') || {}).value || "";
      two.querySelector('input[name="Use Case"]').value = use;
      var fiber = use.trim() === box.dataset.showWhen;
      box.hidden = !fiber;
      box.querySelectorAll("input, select").forEach(function (el) { el.disabled = !fiber; });
      one.hidden = true;
      two.hidden = false;
      two.scrollIntoView({ block: "start", behavior: "smooth" });
      var first = two.querySelector("select, input:not([type=hidden])");
      if (first) first.focus({ preventScroll: true });
    });
    function readFile(f) {
      return new Promise(function (res, rej) { var r = new FileReader(); r.onload = function () { res(String(r.result).split(",")[1] || ""); }; r.onerror = function () { rej(r.error); }; r.readAsDataURL(f); });
    }
    two.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (btn.disabled) return;
      say("");
      var data = new URLSearchParams(), any = false;
      new FormData(two).forEach(function (v, k) { if (!(v instanceof File) && String(v).trim()) { data.append(k, String(v)); if (k !== "Use Case") any = true; } });
      var fileInput = two.querySelector('input[type="file"]'), file = fileInput && fileInput.files && fileInput.files[0];
      if (file) {
        var ext = "." + (file.name.split(".").pop() || "").toLowerCase(), accept = (fileInput.accept || "").split(",");
        if (accept.indexOf(ext) < 0) { say("Please attach an " + accept.join(", ") + " file."); return; }
        if (file.size > 10 * 1024 * 1024) { say("That file is over 10 MB. Please attach a smaller file or email it to us."); return; }
        try { data.append("fileData", await readFile(file)); data.append("fileName", file.name); data.append("fileType", file.type || "application/octet-stream"); any = true; }
        catch (err) { say("We couldn't read that file. Please try again or email it to us."); return; }
      }
      if (!any) { location.href = "/resources"; return; }
      data.append("form", "details");
      data.append("id", id);
      data.append("page", location.pathname);
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        var res = await fetch(two.dataset.endpoint, { method: "POST", body: data });
        var reply = await res.json().catch(function () { return {}; });
        if (reply.result !== "success") throw new Error(reply.error || "HTTP " + res.status);
        btn.textContent = "Thank you";
        setTimeout(function () { location.href = "/resources"; }, 800);
      } catch (err) {
        btn.disabled = false;
        btn.textContent = "Add details";
        say("Something went wrong. Please try again, or email your spec to us.");
      }
    });
  })();
</script></Base>
