---
// The spec box in the hero of the fiber pages ("Tier 1 manufacturing, wholesale supply" /
// "Build-to-order ... cable"). One component so every fiber page shows the same box:
// icon + title, specs as pills in a 2-column grid (stacked on tablet/phone), custom-order note.
// Styling follows the Framer design of the fiber category pages.
interface Props { title: string; chips: string[]; note: string }
const { title, chips, note } = Astro.props;
---
<div class="spec-panel">
  <div class="sp-head">
    <div class="sp-icon">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="rgb(138, 23, 76)" d="M 8 0 C 14.401 0 16 1.599 16 8 C 16 14.401 14.401 16 8 16 C 1.599 16 0 14.401 0 8 C 0 1.599 1.599 0 8 0 M 6.687 12.376 C 8.37 12.378 9.757 10.996 9.76 9.313 C 9.76 7.632 8.377 6.249 6.697 6.249 C 5.016 6.249 3.633 7.633 3.633 9.313 C 3.633 10.99 5.01 12.371 6.687 12.376 M 12.25 12.25 L 12.25 3.75 L 3.75 3.75 L 3.75 5.248 L 10.749 5.248 L 10.749 12.25 Z M 6.687 7.751 C 7.55 7.752 8.249 8.451 8.249 9.314 C 8.248 10.177 7.549 10.876 6.686 10.875 C 5.823 10.875 5.124 10.175 5.125 9.313 C 5.125 8.45 5.825 7.751 6.687 7.751" /></svg>
    </div>
    <h2 class="sp-title">{title}</h2>
  </div>
  <ul class="sp-chips">
    {chips.map((c) => <li><span>{c}</span></li>)}
  </ul>
  <p class="sp-note">{note}</p>
</div>

<style>
  .spec-panel {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 18px;
    width: 100%; padding: 24px; border-radius: 28px; background: var(--white);
  }
  .spec-panel::after {
    content: ""; position: absolute; inset: 0; border: 1px solid rgba(136, 18, 67, 0.14);
    border-radius: inherit; pointer-events: none;
  }
  .sp-head { display: flex; align-items: center; gap: 12px; width: 100%; }
  .sp-icon {
    flex: none; display: grid; place-items: center; width: 46px; height: 46px;
    border-radius: 14px; background: #fff0f7;
  }
  .sp-icon svg { width: 24px; height: 24px; }
  .sp-title {
    flex: 1 0 0; font-family: var(--font-display); font-weight: 800; font-size: 24px;
    letter-spacing: -0.03em; line-height: 1.12; color: var(--ink-900);
  }
  .sp-chips {
    list-style: none; display: grid; grid-template-columns: repeat(2, minmax(1px, 1fr));
    gap: 24px; width: 100%;
  }
  .sp-chips li { font-weight: 800; font-size: 14px; line-height: 1; color: var(--brand-crimson); }
  .sp-chips span {
    display: inline-block; padding: 10px 12px; border-radius: var(--radius-pill); background: var(--brand-pink-50);
  }
  .sp-note { padding-left: 12px; font-weight: 800; font-size: 14px; line-height: 1.3; color: var(--brand-crimson); }
  @media (max-width: 1199.98px) {
    .sp-chips { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 809.98px) {
    .spec-panel { padding: 20px; border-radius: 22px; }
  }
</style>
