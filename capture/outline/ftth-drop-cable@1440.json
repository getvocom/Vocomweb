16},"links":[]},{"t":"a","href":"./products/cassette-adapters","text":"Cassette adapters","box":{"x":755,"y":2293,"w":144,"h":36}},{"t":"p","text":"Cassette adapters","box":{"x":769,"y":2303,"w":116,"h":16},"links":[]},{"t":"a","href":"./products/sc-fiber-patch-cord","text":"SC Fiber Patch Cord","box":{"x":909,"y":2293,"w":155,"h":36}},{"t":"p","text":"SC Fiber Patch Cord","box":{"x":923,"y":2303,"w":127,"h":16},"links":[]},{"t":"a","href":"./products/lc-fiber-patch-cord","text":"LC Fiber Patch Cord","box":{"x":1074,"y":2293,"w":153,"h":36}},{"t":"p","text":"LC Fiber Patch Cord","box":{"x":1088,"y":2303,"w":125,"h":16},"links":[]},{"t":"a","href":"./products/fc-fiber-patch-cord","text":"FC Fiber Patch Cord","box":{"x":221,"y":2338,"w":154,"h":36}},{"t":"p","text":"FC Fiber Patch Cord","box":{"x":235,"y":2348,"w":126,"h":16},"links":[]},{"t":"a","href":"./products/st-fiber-patch-cord","text":"ST Fiber Patch Cord","box":{"x":385,"y":2338,"w":154,"h":36}},{"t":"p","text":"ST Fiber Patch Cord","box":{"x":399,"y":2348,"w":126,"h":16},"links":[]},{"t":"a","href":"./products/mtrj-fiber-patch-cord","text":"MTRJ Fiber Patch Cord","box":{"x":548,"y":2338,"w":174,"h":36}},{"t":"p","text":"MTRJ Fiber Patch Cord","box":{"x":562,"y":2348,"w":146,"h":16},"links":[]},{"t":"a","href":"./products/lc-uniboot-and-lc-extractor-micro-cable","text":"LC Uniboot and LC Extractor Micro Cable","box":{"x":732,"y":2338,"w":285,"h":36}},{"t":"p","text":"LC Uniboot and LC Extractor Micro Cable","box":{"x":746,"y":2348,"w":257,"h":16},"links":[]},{"t":"a","href":"./products/armored-fiber-patch-cord","text":"Armored Fiber Patch Cord","box":{"x":1027,"y":2338,"w":192,"h":36}},{"t":"p","text":"Armored Fiber Patch Cord","box":{"x":1041,"y":2348,"w":164,"h":16},"links":[]},{"t":"a","href":"./products/mtp-mpo-array-cable","text":"MTP/MPO Array Cable","box":{"x":477,"y":2384,"w":171,"h":36}},{"t":"p","text":"MTP/MPO Array Cable","box":{"x":491,"y":2394,"w":143,"h":16},"links":[]},{"t":"a","href":"./products/mtp-mpo-trunk-cable","text":"MTP/MPO Trunk Cable","box":{"x":658,"y":2384,"w":173,"h":36}},{"t":"p","text":"MTP/MPO Trunk Cable","box":{"x":672,"y":2394,"w":145,"h":16},"links":[]},{"t":"a","href":"./products/fiber-adapters","text":"Fiber Adapters","box":{"x":841,"y":2384,"w":122,"h":36}},{"t":"p","text":"Fiber Adapters","box":{"x":855,"y":2394,"w":94,"h":16},"links":[]},{"t":"h2","text":"Why source it through Vocom","box":{"x":310,"y":2608,"w":820,"h":45},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Build-to-order: specified to your route, count and jacket, not off a fixed shelf.","box":{"x":160,"y":2742,"w":181,"h":87},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Fujikura preform glass: tier 1 manufacturing, consistent quality.","box":{"x":395,"y":2742,"w":181,"h":65},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Lead times that move: supply when domestic loose-tube is quoted months out.","box":{"x":630,"y":2742,"w":181,"h":87},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Import/export handled: documentation, customs and delivery coordinated.","box":{"x":864,"y":2742,"w":181,"h":87},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Founded in 1998: a supplier that also runs networks.","box":{"x":1099,"y":2742,"w":181,"h":65},"links":[]},{"t":"h2","text":"FTTH drop cable FAQ","box":{"x":140,"y":3005,"w":1160,"h":45},"links":[]},{"t":"h3","text":"G.657.A1 or A2, which do we need?","box":{"x":162,"y":3100,"w":529,"h":24},"links":[]},{"t":"p","text":"A2 holds the tighter bend spec and is what most indoor and in-home work actually needs. A1 has fewer requirements and is fine on a straighter run. If the cable is going round door frames and into a room, specify A2.","box":{"x":162,"y":3134,"w":529,"h":99},"links":[]},{"t":"h3","text":"Do you supply pre-connectorized drops?","box":{"x":749,"y":3100,"w":529,"h":24},"links":[]},{"t":"p","text":"Yes, with OptiTap compatible connectors to IP68 and GR-3120. Whether that beats field termination depends on your crew rate and your volume, and we are happy to work the numbers with you rather than push one.","box":{"x":749,"y":3134,"w":529,"h":99},"links":[]},{"t":"h3","text":"What protects against rodent damage?","box":{"x":162,"y":3366,"w":529,"h":24},"links":[]},{"t":"p","text":"The armored drop series, NSS and SS, uses spiral armor for mechanical and rodent protection. It costs more per foot and saves more per callout.","box":{"x":162,"y":3400,"w":529,"h":74},"links":[]},{"t":"h3","text":"Can we reorder the same spec?","box":{"x":749,"y":3366,"w":529,"h":24},"links":[]},{"t":"p","text":"Yes. Specs are held against your account, so a repeat order is a quantity and a date rather than a fresh conversation.","box":{"x":749,"y":3400,"w":529,"h":50},"links":[]},{"t":"h3","text":"What is an OptiTap compatible connector?","box":{"x":162,"y":3631,"w":529,"h":24},"links":[]},{"t":"p","text":"OptiTap is the common name for a hardened, sealed fiber drop connector format, first designed by one manufacturer and now available as compatible connectors from several sources. It lets a pre-connectorized drop be plugged into a terminal outdoors, in minutes and without splicing. Vocom supplies OptiTap compatible connectors rated IP68 and built to GR-326 and GR-3120, alongside flat drop cable.","box":{"x":162,"y":3665,"w":529,"h":174},"links":[]},{"t":"p","text":"Need a Fiber Built to Your Exact Specification?","box":{"x":174,"y":3923,"w":1092,"h":32},"links":[]},{"t":"p","text":"Fiber count, jacket, rating and connector, we can source and build any fiber optic cable to match your spec.","box":{"x":420,"y":3967,"w":600,"h":48},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":619,"y":4027,"w":202,"h":45}},{"t":"p","text":"Talk to a Specifier","box":{"x":641,"y":4042,"w":132,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./","text":"","box":{"x":180,"y":4266,"w":33,"h":35}},{"t":"img","src":"https://framerusercontent.com/images/TTIbUaJpCfUwzR62SUUmiGgR