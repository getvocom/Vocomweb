[{"t":"a","href":"./","text":"","box":{"x":35,"y":22,"w":50,"h":40}},{"t":"img","src":"https://framerusercontent.com/images/93Dhh8MlhJlV2Fnjh3zQ7n2fM.png?width=227&height=244","alt":"Vocom logo","box":{"x":44,"y":24,"w":33,"h":35},"nat":[227,244]},{"t":"p","text":"☰","box":{"x":328,"y":28,"w":21,"h":29},"links":[]},{"t":"p","text":"VOCOM AI","box":{"x":80,"y":190,"w":72,"h":16},"links":[]},{"t":"h1","text":"RenOS: The Operating System for Your AI Agents","box":{"x":64,"y":236,"w":262,"h":343},"links":[]},{"t":"p","text":"Run AI agents across any model your team uses. RenOS decides which model handles each task under your rules, explains why in plain language, and writes an audit trail automatically.","box":{"x":64,"y":603,"w":262,"h":202},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Book a Live Demo","box":{"x":64,"y":828,"w":185,"h":51}},{"t":"p","text":"Book a Live Demo","box":{"x":88,"y":840,"w":137,"h":27},"links":[]},{"t":"a","href":"./vocom-ai-agents#how-it-works","text":"See How It Works","box":{"x":64,"y":892,"w":183,"h":51}},{"t":"p","text":"See How It Works","box":{"x":88,"y":904,"w":135,"h":27},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/D9Pz944q4ti1ZvaNJfbNzxXQlY.webp?scale-down-to=512&width=1000&height=700","alt":"","box":{"x":64,"y":1007,"w":262,"h":183},"nat":[262,183]},{"t":"p","text":"RenOS: Admin Dashboard","box":{"x":84,"y":1404,"w":162,"h":16},"links":[]},{"t":"p","text":"TEAMS","box":{"x":84,"y":1454,"w":43,"h":13},"links":[]},{"t":"p","text":"Sales","box":{"x":84,"y":1481,"w":37,"h":17},"links":[]},{"t":"p","text":"Reasoning Model","box":{"x":84,"y":1500,"w":106,"h":16},"links":[]},{"t":"p","text":"Cap set","box":{"x":262,"y":1491,"w":44,"h":14},"links":[]},{"t":"p","text":"Support","box":{"x":84,"y":1529,"w":54,"h":17},"links":[]},{"t":"p","text":"Fast Draft Model","box":{"x":84,"y":1548,"w":102,"h":16},"links":[]},{"t":"p","text":"Lighter model","box":{"x":226,"y":1539,"w":80,"h":14},"links":[]},{"t":"p","text":"Marketing","box":{"x":84,"y":1578,"w":69,"h":17},"links":[]},{"t":"p","text":"Lightweight Model","box":{"x":84,"y":1597,"w":114,"h":16},"links":[]},{"t":"p","text":"Cap set","box":{"x":262,"y":1588,"w":44,"h":14},"links":[]},{"t":"p","text":"Per-team spend caps applied automatically","box":{"x":84,"y":1626,"w":222,"h":29},"links":[]},{"t":"h2","text":"Spend Less on Every AI Task","box":{"x":64,"y":1739,"w":262,"h":77},"links":[]},{"t":"p","text":"RenOS routes each task to the model that can do the job for the lowest cost, not whichever tool happens to be open. Teams on RenOS stop paying for five overlapping subscriptions and start paying only for the work that gets done.","box":{"x":64,"y":1832,"w":262,"h":218},"links":[]},{"t":"h2","text":"Govern and Audit Every Agent","box":{"x":64,"y":2209,"w":262,"h":77},"links":[]},{"t":"p","text":"Every task RenOS routes comes with a plain-language reason and a permanent record: who ran it, which model handled it, which policy applied, and what it cost. Nothing runs outside the record your admin can read.","box":{"x":64,"y":2302,"w":262,"h":190},"links":[]},{"t":"p","text":"RenOS: Audit Trail","box":{"x":84,"y":2571,"w":114,"h":16},"links":[]},{"t":"p","text":"RECENT ACTIVITY","box":{"x":84,"y":2620,"w":110,"h":13},"links":[]},{"t":"p","text":"Draft renewal email","box":{"x":84,"y":2647,"w":222,"h":17},"links":[]},{"t":"p","text":"Reasoning Model · Sales, Standard policy","box":{"x":84,"y":2666,"w":222,"h":29},"links":[]},{"t":"p","text":"Summarize support tickets","box":{"x":84,"y":2709,"w":222,"h":17},"links":[]},{"t":"p","text":"Fast Draft Model · Support, Routine policy","box":{"x":84,"y":2728,"w":222,"h":29},"links":[]},{"t":"p","text":"Draft policy memo","box":{"x":84,"y":2771,"w":222,"h":17},"links":[]},{"t":"p","text":"Frontier Model · Compliance, Sensitive policy","box":{"x":84,"y":2789,"w":222,"h":29},"links":[]},{"t":"p","text":"Exportable for compliance review","box":{"x":84,"y":2832,"w":222,"h":14},"links":[]},{"t":"h2","text":"Your Team Already Uses AI. Can You Prove What It Did?","box":{"x":64,"y":3043,"w":262,"h":216},"links":[]},{"t":"p","text":"Most teams now use five or more AI tools, each billed separately, none of the AI talking to each other, and nobody can show who ran what on which model with what data. RenOS puts one governed layer across all of it.","box":{"x":64,"y":3279,"w":262,"h":230},"links":[]},{"t":"h2","text":"How RenOS Works","box":{"x":64,"y":3701,"w":262,"h":86},"links":[]},{"t":"p","text":"01","box":{"x":88,"y":3859,"w":30,"h":34},"links":[]},{"t":"p","text":"Submit a Task","box":{"x":88,"y":3903,"w":214,"h":23},"links":[]},{"t":"p","text":"Type a request in Chat Mode, start a Builder task, or let an Agent pick it up. You never have to choose a model yourself.","box":{"x":88,"y":3936,"w":214,"h":113},"links":[]},{"t":"p","text":"02","box":{"x":88,"y":4121,"w":36,"h":34},"links":[]},{"t":"p","text":"Policy Decides","box":{"x":88,"y":4165,"w":214,"h":23},"links":[]},{"t":"p","text":"RenOS checks your admin’s rules for the task type, the data involved, and your role, then picks the model before the task runs.","box":{"x":88,"y":4198,"w":214,"h":113},"links":[]},{"t":"p","text":"03","box":{"x":88,"y":4382,"w":36,"h":34},"links":[]},{"t":"p","text":"Routing Rationale","box":{"x":88,"y":4426,"w":214,"h":23},"links":[]},{"t":"p","text":"You see which model ran the task and a one-line reason why, in plain language, not a confidence score.","box":{"x":88,"y":4459,"w":214,"h":90},"links":[]},{"t":"p","text":"04","box":{"x":88,"y":4644,"w":37,"h":34},"links":[]},{"t":"p","text":"Audit Trail","box":{"x":88,"y":4688,"w":214,"h":23},"links":[]},{"t":"p","text":"Every task, model, and decision is logged automatically, ready to export the moment compliance asks.","box":{"x":88,"y":4721,"w":214,"h":90},"links":[]},{"t":"h2","text":"Chat, Builder and Agent Modes","box":{"x":64,"y":5049,"w":262,"h":130},"links":[]},{"t":"p","text":"Chat","box":{"x":92,"y":5255,"w":206,"h":24},"links":[]},{"t":"p","text":"Ask a question or hand off a task. RenOS routes it to the right model and shows you why.","box":{"x":92,"y":5289,"w":206,"h":90},"links":[]},{"t":"p","text":"Builder","box":{"x":92,"y":5459,"w":206,"h":24},"links":[]},{"t":"p","text":"Run a task across more than one model side by side and compare the results before you commit.","box":{"x":92,"y":5493,"w":206,"h":90},"links":[]},{"t":"p","text":"Agent","box":{"x":92,"y":5663,"w":206,"h":24},"links":[]},{"t":"p","text":"Let agents work together on one task under your rules, with every handoff recorded.","box":{"x":92,"y":5697,"w":206,"h":68},"links":[]},{"t":"h2","text":"AI Coaching Agents for Sales, Leadership and Frontline Teams","box":{"x":64,"y":6007,"w":262,"h":216},"links":[]},{"t":"p","text":"Coaching started as its own product, Vocom AI Coach Hub. It’s now built into RenOS as a set of coaching agents covering recruiting, sales, leadership and frontline teams, so coaching activity sits inside the same governed system as every other agent.","box":{"x":64,"y":6255,"w":262,"h":259},"links":[]},{"t":"h3","text":"Sales Practice","box":{"x":92,"y":6574,"w":206,"h":23},"links":[]},{"t":"p","text":"Scenario simulation and real-time feedback for pitch, negotiation and service conversations.","box":{"x":92,"y":6608,"w":206,"h":90},"links":[]},{"t":"h3","text":"Leadership Development","box":{"x":92,"y":6779,"w":206,"h":47},"links":[]},{"t":"p","text":"Simulated dialogue and 9-box reporting for succession and promotion readiness.","box":{"x":92,"y":6835,"w":206,"h":68},"links":[]},{"t":"h3","text":"Frontline Skill Building","box":{"x":92,"y":6983,"w":206,"h":23},"links":[]},{"t":"p","text":"Guided coaching with progress tracking for onboarding, support and frontline service roles.","box":{"x":92,"y":7016,"w":206,"h":90},"links":[]},{"t":"p","text":"COACH HUB DEPLOYMENTS","box":{"x":88,"y":7191,"w":214,"h":14},"links":[]},{"t":"p","text":"Finance","box":{"x":170,"y":7222,"w":50,"h":16},"links":[]},{"t":"p","text":"50% fewer training hours","box":{"x":117,"y":7241,"w":156,"h":16},"links":[]},{"t":"p","text":"Healthcare","box":{"x":160,"y":7297,"w":70,"h":16},"links":[]},{"t":"p","text":"60 to 70% lower nursing workload","box":{"x":90,"y":7316,"w":211,"h":16},"links":[]},{"t":"p","text":"Retail","box":{"x":177,"y":7372,"w":36,"h":16},"links":[]},{"t":"p","text":"3 hours a day reclaimed","box":{"x":121,"y":7392,"w":147,"h":16},"links":[]},{"t":"h2","text":"Why Teams Choose RenOS","box":{"x":64,"y":7623,"w":262,"h":86},"links":[]},{"t":"h3","text":"Any Model, One Place","box":{"x":64,"y":7758,"w":262,"h":22},"links":[]},{"t":"p","text":"Hundreds of models behind one interface, so your team stops paying for five overlapping subscriptions.","box":{"x":64,"y":7788,"w":262,"h":63},"links":[]},{"t":"h3","text":"Neutral by Design","box":{"x":64,"y":7896,"w":262,"h":22},"links":[]},{"t":"p","text":"RenOS does not belong to any model vendor, so it can route and log every one of them the same way.","box":{"x":64,"y":7926,"w":262,"h":63},"links":[]},{"t":"h3","text":"Admin Visibility","box":{"x":64,"y":8034,"w":262,"h":22},"links":[]},{"t":"p","text":"One dashboard shows every session, model, and spend amount, by person or by team, without anyone having to ask.","box":{"x":64,"y":8064,"w":262,"h":84},"links":[]},{"t":"h3","text":"Private Deployment Option","box":{"x":64,"y":8172,"w":262,"h":22},"links":[]},{"t":"p","text":"Run RenOS inside your own environment as an add-on, so sensitive data never has to leave it.","box":{"x":64,"y":8202,"w":262,"h":63},"links":[]},{"t":"h3","text":"Nothing Extra for Users","box":{"x":64,"y":8310,"w":262,"h":22},"links":[]},{"t":"p","text":"Governance happens in the background. People submit a task in Chat, Builder, or Agent mode and just get their work done.","box":{"x":64,"y":8340,"w":262,"h":84},"links":[]},{"t":"h3","text":"Human Handoff","box":{"x":64,"y":8448,"w":262,"h":22},"links":[]},{"t":"p","text":"Agents escalate to your team the moment a task needs a person to step in.","box":{"x":64,"y":8478,"w":262,"h":63},"links":[]},{"t":"p","text":"Built for the Teams That Answer for Their AI","box":{"x":64,"y":8754,"w":262,"h":173},"links":[]},{"t":"p","text":"Different teams submit different work. RenOS applies the right policy to each one without anyone having to think about it.","box":{"x":64,"y":8951,"w":262,"h":109},"links":[]},{"t":"p","text":"Sales","box":{"x":112,"y":9092,"w":37,"h":17},"links":[]},{"t":"p","text":"Compliance","box":{"x":197,"y":9092,"w":81,"h":17},"links":[]},{"t":"p","text":"IT","box":{"x":127,"y":9137,"w":13,"h":17},"links":[]},{"t":"p","text":"Operations","box":{"x":188,"y":9137,"w":75,"h":17},"links":[]},{"t":"p","text":"Leadership Coaching","box":{"x":123,"y":9181,"w":144,"h":17},"links":[]},{"t":"p","text":"Finance","box":{"x":168,"y":9226,"w":54,"h":17},"links":[]},{"t":"h2","text":"Governed AI, Built Around Your Industry","box":{"x":64,"y":9443,"w":262,"h":130},"links":[]},{"t":"p","text":"RenOS adapts to the rules your industry already runs on, from data handling to who is allowed to approve what.","box":{"x":64,"y":9597,"w":262,"h":109},"links":[]},{"t":"p","text":"Healthcare","box":{"x":88,"y":9737,"w":74,"h":17},"links":[]},{"t":"p","text":"Credit Unions","box":{"x":210,"y":9737,"w":92,"h":17},"links":[]},{"t":"p","text":"Real Estate","box":{"x":158,"y":9782,"w":75,"h":17},"links":[]},{"t":"p","text":"Professional Services","box":{"x":122,"y":9827,"w":147,"h":17},"links":[]},{"t":"p","text":"Telecom & MSPs","box":{"x":139,"y":9872,"w":113,"h":17},"links":[]},{"t":"p","text":"Dental Groups","box":{"x":147,"y":9917,"w":96,"h":17},"links":[]},{"t":"p","text":"Property Management","box":{"x":119,"y":9961,"w":152,"h":17},"links":[]},{"t":"p","text":"Insurance","box":{"x":112,"y":10006,"w":67,"h":17},"links":[]},{"t":"p","text":"Fintech","box":{"x":227,"y":10006,"w":50,"h":17},"links":[]},{"t":"h2","text":"Start With a 60-Day Pilot","box":{"x":64,"y":10223,"w":262,"h":86},"links":[]},{"t":"p","text":"A 60-day design-partner pilot with a written success plan, run on one real workflow from your team.","box":{"x":64,"y":10333,"w":262,"h":115},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to Us About a Pilot","box":{"x":83,"y":10473,"w":225,"h":51}},{"t":"p","text":"Talk to Us About a Pilot","box":{"x":107,"y":10485,"w":177,"h":27},"links":[]},{"t":"h2","text":"RenOS Frequently Asked Questions","box":{"x":64,"y":10716,"w":262,"h":173},"links":[]},{"t":"p","text":"What is RenOS?","box":{"x":80,"y":10929,"w":194,"h":24},"links":[]},{"t":"svg","w":20},{"t":"p","text":"How is RenOS different from a single AI assistant?","box":{"x":80,"y":10978,"w":194,"h":48},"links":[]},{"t":"svg","w":20},{"t":"p","text":"Which AI models does RenOS work with?","box":{"x":80,"y":11052,"w":194,"h":48},"links":[]},{"t":"svg","w":20},{"t":"p","text":"Where does our data go?","box":{"x":80,"y":11126,"w":194,"h":24},"links":[]},{"t":"svg","w":20},{"t":"p","text":"Can RenOS run in our own environment?","box":{"x":80,"y":11175,"w":194,"h":48},"links":[]},{"t":"svg","w":20},{"t":"p","text":"What happened to Vocom AI Coach Hub?","box":{"x":80,"y":11249,"w":194,"h":48},"links":[]},{"t":"svg","w":20},{"t":"p","text":"Will our existing systems work with RenOS?","box":{"x":80,"y":11323,"w":194,"h":48},"links":[]},{"t":"svg","w":20},{"t":"p","text":"How do we get started?","box":{"x":80,"y":11396,"w":194,"h":24},"links":[]},{"t":"svg","w":20},{"t":"h2","text":"See RenOS Run on Your Own Work","box":{"x":64,"y":11620,"w":262,"h":130},"links":[]},{"t":"p","text":"Bring one real task and we’ll route it live, rationale and audit trail included.","box":{"x":64,"y":11774,"w":262,"h":86},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Book a Demo","box":{"x":120,"y":11884,"w":149,"h":51}},{"t":"p","text":"Book a Demo","box":{"x":144,"y":11896,"w":101,"h":27},"links":[]},{"t":"a","href":"./vocom-ai","text":"Explore Vocom AI","box":{"x":1