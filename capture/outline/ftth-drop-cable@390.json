"x":48,"y":891,"w":306,"h":36},"links":[]},{"t":"p","text":"100+","box":{"x":142,"y":992,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":172,"y":1040,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":124,"y":1107,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":174,"y":1155,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":102,"y":1223,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":175,"y":1271,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":146,"y":1338,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":172,"y":1386,"w":46,"h":16},"links":[]},{"t":"p","text":"What it is","box":{"x":16,"y":1629,"w":358,"h":35},"links":[]},{"t":"p","text":"The drop is the last hundred feet and the part that gets touched most. It runs an aerial span, down a wall, through an entry point and into a room, so it needs to bend tighter than outside plant cable ever does and survive being handled by a crew working fast. Bend spec and termination method decide the labor cost per drop, which is the number that actually matters at volume.","box":{"x":16,"y":1678,"w":358,"h":297},"links":[]},{"t":"p","text":"Product codes","box":{"x":38,"y":2021,"w":314,"h":20},"links":[]},{"t":"p","text":"Flat drop, flat drop with tracing wire, armored drop NSS and SS, FTTR low-visibility, GYFXBTC8F","box":{"x":38,"y":2047,"w":314,"h":61},"links":[]},{"t":"p","text":"Fiber type","box":{"x":38,"y":2144,"w":314,"h":20},"links":[]},{"t":"p","text":"G.657A1 and G.657.A2 bend-insensitive, G.657.B3 available","box":{"x":38,"y":2170,"w":314,"h":41},"links":[]},{"t":"p","text":"Fiber counts","box":{"x":38,"y":2246,"w":314,"h":20},"links":[]},{"t":"p","text":"1F to 12F","box":{"x":38,"y":2273,"w":314,"h":20},"links":[]},{"t":"p","text":"Construction","box":{"x":38,"y":2329,"w":314,"h":20},"links":[]},{"t":"p","text":"Flat drop, spiral armored, round in and outdoor","box":{"x":38,"y":2355,"w":314,"h":41},"links":[]},{"t"