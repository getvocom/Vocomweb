---
// Converted from Framer by scripts/framer/compile.mjs, then maintained by hand.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import FaqItem from "../../components/FaqItem.astro";
import Footer from "../../components/Footer.astro";
import { getPosts, getProducts } from "../../lib/cms";
import "../../styles/pages/products/_slug.css";
import { blogSeo, productSeo } from "../../lib/seo";
export async function getStaticPaths() {
  return (await getProducts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const path = "/products/" + entry.id;
const seo = productSeo(path, entry);
const products = await getProducts();
