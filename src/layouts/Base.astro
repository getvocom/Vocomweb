b.type = "text/javascript";b.async = true;
b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
s.parentNode.insertBefore(b, s);})(window.lintrk);
</script>
  </head>
  <body>
    <slot />
    <CookieBanner />
    <NewsletterPopup />
    <script is:inline>
      // Tap-to-switch component variants: [data-set-variant] sets data-variant on the nearest [data-variants] root.
      (function () {
        function go(t) {
          var r = t.closest("[data-variants]"); if (!r) return;
          var v = t.getAttribute("data-set-variant");
          r.setAttribute("data-variant", v);
          r.querySelectorAll("[data-open-in]").forEach(function (el) {
            if (el.getAttribute("data-open-in").split("|").indexOf(v) >= 0) el.setAttribute("data-open", ""); else el.removeAttribute("data-open");
          });
        }
        document.addEventListener("click", function (e) { var t = e.target.closest("[data-set-variant]"); if (t) { if (t.tagName !== "A") e.preventDefault(); go(t); } });
        document.addEventListener("keydown", function (e) { if ((e.key === "Enter" || e.key === " ") && e.target.matches && e.target.matches("[data-set-variant]")) { e.preventDefault(); go(e.target); } });
      })();
      // Videos: attach the source and play only while on screen (saves megabytes per page).
      (function () {
        var vids = document.querySelectorAll("video[data-src]");
        if (!vids.length) return;
        function load(v) { if (!v.src) { v.src = v.getAttribute("data-src"); v.preload = "auto"; } }
        if (!("IntersectionObserver" in window)) { vids.forEach(function (v) { load(v); if (v.hasAttribute("data-autoplay")) v.play().catch(function () {}); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var v = e.target;
            if (e.isIntersecting) { load(v); if (v.hasAttribute("data-autoplay")) v.play().catch(function () {}); }
            else if (!v.paused) v.pause();
          });
        }, { rootMargin: "200px 0px" });
        vids.forEach(function (v) { io.observe(v); });
      })();
      // Masonry grids: pack items into the shortest column like Framer does.
      (function () {
        if (window.CSS && CSS.supports("grid-template-rows", "masonry")) return;
        function layout() {
          document.querySelectorAll(".masonry").forEach(function (g) {
            g.classList.add("masonry-on");
            var gap = parseFloat(getComputedStyle(g).rowGap) || 0;
            Array.prototype.forEach.call(g.children, function (c) {
              c.style.gridRowEnd = "auto";
              var h = c.getBoundingClientRect().height;
              c.style.gridRowEnd = "span " + Math.max(1, Math.ceil((h + gap) / (8 + gap)));
            });
          });
        }
        layout();
        addEventListener("load", layout);
        addEventListener("resize", layout);
        document.querySelectorAll(".masonry img").forEach(function (i) { i.addEventListener("load", layout); });
      })();
    </script>
    <!-- Metricool -->
    <img src="https://tracker.metricool.com/c3po.jpg?hash=a510ea6b2f7a6b3e8cf12a619c234f76" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none" />
    <!-- LinkedIn conversion pixel (conversion 24546316), fires on every page as on the live site -->
    <img height="1" width="1" style="display:none;" alt="" src="https://px.ads.linkedin.com/collect/?pid=8874748&conversionId=24546316&fmt=gif" />
    {siteLd.map((j) => <script type="application/ld+json" set:html={j} />)}
  </body>
</html>
