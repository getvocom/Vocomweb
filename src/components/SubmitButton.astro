---
// Quote form submit button + submit handler (replaces Framer's form + "Button 5").
// States match the live button: Disabled until required fields are filled, Loading
// spinner, "Thank you" on success (then redirect to /resources), "Something went wrong" on error.
// Submissions POST to the Google Apps Script in src/config.ts (QUOTE_FORM_URL).
// Spam protection: a hidden honeypot field, Framer's hidden decoy fields, a minimum fill time,
// and Cloudflare Turnstile when TURNSTILE_SITE_KEY is set (checked again in apps-script/Code.gs).
// An optional requirements file (input name "Requirements File") is sent base64-encoded.
import { QUOTE_FORM_URL, QUOTE_FORM_FALLBACK_EMAIL, TURNSTILE_SITE_KEY, QUOTE_FILE } from "../config";
---
{TURNSTILE_SITE_KEY && (
  <>
    <script is:inline>window.vocomTurnstileFailed = function () { window.__turnstileFailed = true; };</script>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer onerror="window.__turnstileFailed=true"></script>
    <div class="cf-turnstile turnstile-slot" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only" data-size="flexible" data-error-callback="vocomTurnstileFailed"></div>
  </>
)}
<p class="form-msg" role="alert" hidden></p>
<button type="submit" class="submit-btn" data-state="disabled" data-endpoint={QUOTE_FORM_URL} data-fallback={QUOTE_FORM_FALLBACK_EMAIL} data-turnstile={TURNSTILE_SITE_KEY ? "1" : ""} data-max-mb={QUOTE_FILE.maxMB} data-accept={QUOTE_FILE.accept}>
  <p class="label default">Submit</p>
  <p class="label success">Thank you</p>
  <p class="label error">Something went wrong</p>
  <span class="spinner" aria-hidden="true"></span>
  <span class="sr-only" aria-live="polite"></span>
</button>

<style>
  .submit-btn {
    display: flex; align-items: center; justify-content: center; width: 100%; height: 40px; flex: none;
    border: 0; border-radius: 10px; cursor: pointer; padding: 0;
    background: var(--color-vocom); transition: background-color 0.2s cubic-bezier(0.44, 0, 0.56, 1), opacity 0.2s;
    font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--white);
  }
  .submit-btn:hover { background: var(--color-vocom-cta-1); }
  .submit-btn:active { background: var(--color-vocom-light); }
  .submit-btn .label, .submit-btn .spinner { display: none; }
  .submit-btn[data-state="default"] .default, .submit-btn[data-state="disabled"] .default { display: inline; }
  .submit-btn[data-state="disabled"] { background: var(--color-shadow); opacity: 0.5; cursor: unset; }
  .submit-btn[data-state="loading"] { cursor: unset; }
  .submit-btn[data-state="loading"] .spinner { display: block; }
  .submit-btn[data-state="success"] { background: rgb(8, 61, 27); cursor: unset; }
  .submit-btn[data-state="success"] .success { display: inline; }
  .submit-btn[data-state="error"] { background: rgba(255, 34, 68, 0.15); color: rgb(255, 34, 68); cursor: unset; }
  .submit-btn[data-state="error"] .error { display: inline; }
  .spinner {
    width: 20px; height: 20px; border-radius: 50%;
    background: conic-gradient(from 180deg, rgba(255, 255, 255, 0) 0deg, #fff 342deg);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    animation: spin 1s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .turnstile-slot { width: 100%; }
  .form-msg { width: 100%; margin: 0 0 8px; font-size: 13px; line-height: 1.4; color: rgb(185, 28, 28); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".submit-btn").forEach((btn) => {
    const form = btn.closest("form");
    if (!form) return;
    const live = btn.querySelector(".sr-only")!;
    // honeypot: bots fill it, people never see it
    const hp = document.createElement("input");
    Object.assign(hp, { type: "text", name: "website", tabIndex: -1, autocomplete: "off" });
    hp.setAttribute("aria-hidden", "true");
    hp.style.cssText = "position:absolute;left:-9999px;width:1px;height:1px;opacity:0";
    form.appendChild(hp);
    // Framer's hidden decoy inputs: out of the tab order; "Website" and "Fax" are bot traps
    // (browsers never autofill those, unlike Phone Number / Address)
    form.querySelectorAll<HTMLInputElement>('input[name="Website"], input[name="Fax"], input[name="Phone Number"], input[name="Address"]').forEach((i) => { i.tabIndex = -1; i.autocomplete = "off"; i.setAttribute("aria-hidden", "true"); });
    const traps = () => ["Website", "Fax"].some((n) => (form.querySelector<HTMLInputElement>(`input[name="${n}"]`)?.value ?? "").trim());
    const started = Date.now();
    const msg = form.querySelector<HTMLElement>(".form-msg");
    const say = (t: string) => { if (msg) { msg.textContent = t; msg.hidden = !t; } };
    const maxBytes = Number(btn.dataset.maxMb || 10) * 1024 * 1024;
    const accept = (btn.dataset.accept || "").split(",").map((x) => x.trim().toLowerCase()).filter(Boolean);
    const readFile = (f: File) => new Promise<string>((res, rej) => { const r = new FileReader(); r.onload = () => res(String(r.result).split(",")[1] || ""); r.onerror = () => rej(r.error); r.readAsDataURL(f); });
    const update = () => { if (btn.dataset.state === "default" || btn.dataset.state === "disabled") btn.dataset.state = form.checkValidity() ? "default" : "disabled"; };
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    update();
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity() || btn.dataset.state === "loading") return;
      say("");
      // bots: fake success, send nothing
      if (hp.value || traps() || Date.now() - started < 3000) { btn.dataset.state = "success"; return; }
      const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
      const file = fileInput?.files?.[0];
      if (file) {
        const ext = "." + (file.name.split(".").pop() || "").toLowerCase();
        if (accept.length && !accept.includes(ext)) { say(`Please attach an ${accept.join(", ")} file.`); return; }
        if (file.size > maxBytes) { say(`That file is over ${btn.dataset.maxMb} MB. Please attach a smaller file or email it to us.`); return; }
      }
      // If Turnstile itself fails (blocked script, network, Cloudflare outage) the request still goes
      // through, flagged "unavailable", so a real lead is never lost; Code.gs marks it unverified.
      const tsFailed = !!(window as any).__turnstileFailed;
      if (btn.dataset.turnstile && !tsFailed && !String(new FormData(form).get("cf-turnstile-response") || "")) { say("Please wait a moment for the security check, then submit again."); return; }
      const endpoint = btn.dataset.endpoint;
      if (!endpoint) {
        btn.dataset.state = "error";
        live.textContent = btn.dataset.fallback ? `The form is not connected yet. Please email ${btn.dataset.fallback}.` : "The form is not connected yet.";
        return;
      }
      btn.dataset.state = "loading";
      const data = new URLSearchParams();
      new FormData(form).forEach((v, k) => { if (k !== "website" && !(v instanceof File)) data.append(k.trim(), String(v)); });
      data.append("page", location.pathname);
      data.append("elapsed", String(Date.now() - started));
      if (tsFailed) data.append("turnstile", "unavailable");
      if (file) {
        try { data.append("fileData", await readFile(file)); data.append("fileName", file.name); data.append("fileType", file.type || "application/octet-stream"); }
        catch { say("We couldn't read that file. Please try again or email it to us."); btn.dataset.state = "default"; return; }
      }
      try {
        // Apps Script web apps do not send CORS headers; no-cors posts still deliver.
        await fetch(endpoint, { method: "POST", mode: "no-cors", body: data });
        btn.dataset.state = "success";
        live.textContent = "Thank you";
        window.dispatchEvent(new CustomEvent("quote-form-submitted"));
        (window as any).dataLayer?.push({ event: "form-submission" });
        // after a successful quote request, send the visitor to the resources page (Tom, 2026-10-22)
        setTimeout(() => { location.href = "/resources"; }, 1200);
      } catch {
        btn.dataset.state = "error";
        live.textContent = "Something went wrong";
        setTimeout(() => { btn.dataset.state = "default"; }, 4000);
      }
    });
  });
</script>
