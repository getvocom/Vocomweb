:48,"y":891,"w":306,"h":36},"links":[]},{"t":"p","text":"100+","box":{"x":142,"y":992,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":172,"y":1040,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":124,"y":1107,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":174,"y":1155,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":102,"y":1223,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":175,"y":1271,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":146,"y":1338,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":172,"y":1386,"w":46,"h":16},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/aSyorTzS8jgTuIXYnzAb7gbSM.png?width=1920&height=1080","alt":"ADSS aerial self-supporting fiber optic cable strung on a pole","box":{"x":-382,"y":1629,"w":1155,"h":410},"nat":[1155,649]},{"t":"p","text":"What it is","box":{"x":16,"y":2067,"w":358,"h":35},"links":[]},{"t":"p","text":"This is a route decision before it is a product decision. A long pole span with no messenger available wants ADSS, which carries its own weight and stays all-dielectric so it can run near power without bonding. A shorter span is usually cheaper on figure 8. A trench wants armor. Pick the route first and the cable follows.","box":{"x":16,"y":2116,"w":358,"h":267},"links":[]},{"t":"p","text":"Product codes","box":{"x":38,"y":2429,"w":314,"h":20},"links":[]},{"t":"p","text":"ADSS, figure 8, armored direct burial, hybrid fiber and copper","box":{"x":38,"y":2455,"w":314,"h":41},"links":[]},{"t":"p","text":"Fiber type","box":{"x":38,"y":2532,"w":314,"h":20},"links":[]},{"t":"p","text":"G.652D single-mode, G.657A1 available","box":{"x":38,"y":2558,"w":314,"h":20},"links":[]},{"t":"p","text":"Fiber counts","box":{"x":38,"y":2614,"w":314,"h":20},"links":[]},{"t":"p","text":"12F to 432F","box":{"x":38,"y":2640,"w":314,"h":20},"links":[]},{"t":"p","text":"Construction","box":{"x":38,"y":2697,"w":314,"h":20},"links":[]},{"t":"p","text":"All-dielectric self-supporting, integrated messenger, round armored","box":{"x":38,"y":2723,"w":314,"h":41},"links":[]},{"t":"p","text":"Jacket and protection","box":{"x":38,"y":2799,"w":314,"h":20},"links":[]},{"t":"p","text":"UV stable HDPE, rodent resistant armor, water blocking","box":{"x":38,"y":2826,"w":314,"h":41},"links":[]},{"t":"p","text":"Deployment","box":{"x":38,"y":2902,"w":314,"h":20},"links":[]},{"t":"p","text":"Aerial self-supporting, aerial lashed, direct burial, tower and FTTA","box":{"x":38,"y":2928,"w":314,"h":41},"links":[]},{"t":"p","text":"Lead time","box":{"x":38,"y":3005,"w":314,"h":20},"links":[]},{"t":"p","text":"6 to 8 weeks from PO, up to 10 weeks for custom builds","box":{"x":38,"y":3031,"w":314,"h":41},"links":[]},{"t":"p","text":"Counts by span and route","box":{"x":34,"y":3196,"w":322,"h":69},"links":[]},{"t":"p","text":"Span rating and count specified together, because the two constrain each other. Drum lengths quoted per route.","box":{"x":34,"y":3293,"w":322,"h":112},"links":[]},{"t":"p","text":"12F","box":{"x":96,"y":3446,"w":32,"h":20},"links":[]},{"t":"p","text":"24F","box":{"x":259,"y":3446,"w":37,"h":20},"links":[]},{"t":"p","text":"48F","box":{"x":93,"y":3504,"w":38,"h":20},"links":[]},{"t":"p","text":"96F","box":{"x":259,"y":3504,"w":37,"h":20},"links":[]},{"t":"p","text":"144F","box":{"x":89,"y":3562,"w":47,"h":20},"links":[]},{"t":"p","text":"288F","box":{"x":253,"y":3562,"w":49,"h":20},"links":[]},{"t":"p","text":"432F","box":{"x":87,"y":3620,"w":50,"h":20},"links":[]},{"t":"p","text":"Browse individual products","box":{"x":16,"y":3817,"w":358,"h":26},"links":[]},{"t":"a","href":"./products/adss-all-dielectric","text":"ADSS all-dielectric","box":{"x":76,"y":3862,"w":148,"h":36}},{"t":"p","text":"ADSS all-dielectric","box":{"x":90,"y":3872,"w":120,"h":16},"links":[]},{"t":"a","href":"./products/figure-8","text":"Figure 8","box":{"x":234,"y":3862,"w":80,"h":36}},{"t":"p","text":"Figure 8","box":{"x":248,"y":3872,"w":52,"h":16},"links":[]},{"t":"a","href":"./products/armored-direct-burial","text":"Armored direct burial","box":{"x":19,"y":3907,"w":163,"h":36}},{"t":"p","text":"Armored direct burial","box":{"x":33,"y":3917,"w":135,"h":16},"links":[]},{"t":"a","href":"./products/hybrid-fiber-and-copper","text":"Hybrid fiber and copper","box":{"x":192,"y":3907,"w":179,"h":36}},{"t":"p","text":"Hybrid fiber and copper","box":{"x":206,"y":3917,"w":151,"h":16},"links":[]},{"t":"p","text":"Why source it through Vocom","box":{"x":16,"y":4108,"w":358,"h":69},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Build-to-order: specified to your route, count and jacket, not off a fixed shelf.","box":{"x":36,"y":4265,"w":318,"h":44},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Fujikura preform glass: tier 1 manufacturing, consistent quality.","box":{"x":36,"y":4401,"w":318,"h":44},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Lead times that move: supply when domestic loose-tube is quoted months out.","box":{"x":36,"y":4536,"w":318,"h":44},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Import/export handled: documentation, customs and delivery coordinated.","box":{"x":36,"y":4672,"w":318,"h":44},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Founded in 1998: a supplier that also runs networks.","box":{"x":36,"y":4807,"w":318,"h":44},"links":[]},{"t":"p","text":"ADSS and aerial fiber cable FAQ","box":{"x":16,"y":4979,"w":358,"h":69},"links":[]},{"t":"p","text":"When is all-dielectric mandatory?","box":{"x":38,"y":5098,"w":314,"h":48},"links":[]},{"t":"p","text":"Any span sharing structure with energized conductors. All-dielectric construction has no metallic element, so there is nothing to bond or ground and nothing to induce onto.","box":{"x":38,"y":5156,"w":314,"h":124},"links":[]},{"t":"p","text":"ADSS or figure 8?","box":{"x":38,"y":5336,"w":314,"h":24},"links":[]},{"t":"p","text":"ADSS on long spans where no messenger exists and the cable has to carry itself. Figure 8 on shorter spans, where the integrated messenger is usually the cheaper way to get there. Send the span lengths and the loading class.","box":{"x":38,"y":5370,"w":314,"h":174},"links":[]},{"t":"p","text":"What span can you support?","box":{"x":38,"y":5599,"w":314,"h":24},"links":[]},{"t":"p","text":"Span rating depends on count, jacket and ice or wind loading class, so it is quoted per route rather than published as one number. Give us the longest span on the run and the loading class and we will spec against it.","box":{"x":38,"y":5633,"w":314,"h":149},"links":[]},{"t":"p","text":"Do you supply hybrid cable for tower sites?","box":{"x":38,"y":5838,"w":314,"h":48},"links":[]},{"t":"p","text":"Yes, two copper and two fiber for FTTA and antenna sites, with IP68 waterproof connectors and terminal boxes in LC and MT types.","box":{"x":38,"y":5896,"w":314,"h":99},"links":[]},{"t":"h3","text":"What is self-supporting aerial cable?","box":{"x":38,"y":6051,"w":314,"h":48},"links":[]},{"t":"p","text":"Self-supporting aerial cable is fiber cable that carries its own strength member, so it can be hung from poles or towers without a separate messenger wire. ADSS, all-dielectric self-supporting cable, contains no metal, which is why it suits spans that share structure with energized power lines. Vocom supplies ADSS aerial fiber cable build-to-order, with a standard lead time of 6 to 8 weeks.","box":{"x":38,"y":6109,"w":314,"h":273},"links":[]},{"t":"p","text":"Need a Fiber Built to Your Exact Specification?","box":{"x":50,"y":6135,"w":290,"h":97},"links":[]},{"t":"p","text":"Fiber count, jacket, rating and connector, we can source and build any fiber optic cable to match your spec.","box":{"x":50,"y":6244,"w":290,"h":96},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":94,"y":6352,"w":202,"h":45}},{"t":"p","text":"Talk to a Specifier","box":{"x":116,"y":6367,"w":132,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./","text":""