---
// Custom 404 (Cloudflare Pages serves dist/404.html for unknown URLs with a 404 status).
// Copy matches the live Framer 404: "Page not found / This page doesn't exist or has moved."
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const seo = { title: "Page Not Found | Vocom", description: "", canonical: "https://www.vocom.ai/404" };
---
<Base path="/404" seo={seo} noindex>
  <div class="nf-page">
    <div class="site-header-slot"><Header /></div>
    <main class="nf-main">
      <h1>Page not found</h1>
      <p>This page doesn’t exist or has moved.</p>
      <a class="nf-btn" href="/">Back to home</a>
    </main>
    <div class="nf-footer"><Footer /></div>
  </div>
</Base>

<style>
  .nf-page { display: flex; flex-direction: column; align-items: center; min-height: 100vh; background: linear-gradient(180deg, var(--white) 0%, var(--color-vocom-white) 100%); }
  .nf-main { flex: 1 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 160px 24px; text-align: center; }
  .nf-main h1 { font-family: var(--font-display); font-weight: 800; font-size: 64px; line-height: 1.08; letter-spacing: -0.05em; color: var(--ink-heading); }
  .nf-main p { font-size: 18px; line-height: 1.55; color: var(--gray-600); }
  .nf-btn { margin-top: 12px; display: inline-flex; align-items: center; padding: 14px 24px; border-radius: var(--radius-pill); background: var(--color-vocom-cta-1); color: var(--white); font-weight: 600; font-size: 15px; }
  .nf-btn:hover { background: var(--color-vocom); }
  .nf-footer { width: 100%; }
  @media (max-width: 809.98px) { .nf-main h1 { font-size: 40px; } .nf-main { padding: 96px 20px; } }
</style>
