[{"t":"a","href":"./","text":"","box":{"x":36,"y":22,"w":50,"h":40}},{"t":"img","src":"https://framerusercontent.com/images/93Dhh8MlhJlV2Fnjh3zQ7n2fM.png?width=227&height=244","alt":"Vocom logo","box":{"x":45,"y":24,"w":33,"h":35},"nat":[227,244]},{"t":"p","text":"☰","box":{"x":705,"y":28,"w":21,"h":29},"links":[]},{"t":"svg","w":16},{"t":"p","text":"Indoor and outdoor fiber cable supply","box":{"x":52,"y":131,"w":248,"h":14},"links":[]},{"t":"p","text":"Air Blown Micro Fiber Cable for Indoor and Outdoor Microduct","box":{"x":16,"y":172,"w":736,"h":80},"links":[]},{"t":"p","text":"Micro cable, HDPE microduct bundles from 5 to 27mm and composite vaults, specified together as one order for indoor riser or outdoor blown installs. Sourced build-to-order from tier 1 manufacturers and delivered in 6 to 8 weeks standard, up to 10 weeks for custom builds, while micro cable is quoted in months across most of the market.","box":{"x":16,"y":270,"w":736,"h":99},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Check Availability","box":{"x":16,"y":387,"w":736,"h":45}},{"t":"p","text":"Check Availability","box":{"x":304,"y":402,"w":134,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./fiber-optic-cables","text":"See all fiber cables","box":{"x":16,"y":444,"w":736,"h":43}},{"t":"p","text":"See all fiber cables","box":{"x":314,"y":458,"w":140,"h":15},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":16,"y":499,"w":172,"h":43}},{"t":"p","text":"Talk to a Specifier","box":{"x":36,"y":513,"w":132,"h":15},"links":[]},{"t":"p","text":"Build-to-order indoor and outdoor cable","box":{"x":94,"y":594,"w":638,"h":27},"links":[]},{"t":"p","text":"Micro cable and duct","box":{"x":36,"y":648,"w":696,"h":14},"links":[]},{"t":"p","text":"24F to 288F","box":{"x":36,"y":686,"w":696,"h":14},"links":[]},{"t":"p","text":"5mm to 27mm OD","box":{"x":36,"y":724,"w":696,"h":14},"links":[]},{"t":"p","text":"SCTE-77 Tier 22","box":{"x":36,"y":762,"w":696,"h":14},"links":[]},{"t":"p","text":"Need a different spec? We also build to custom order.","box":{"x":48,"y":794,"w":684,"h":18},"links":[]},{"t":"p","text":"100+","box":{"x":331,"y":876,"w":107,"h":44},"links":[]},{"t":"p","text":"Regions","box":{"x":361,"y":924,"w":46,"h":16},"links":[]},{"t":"p","text":"99.9%","box":{"x":313,"y":992,"w":142,"h":44},"links":[]},{"t":"p","text":"Uptime","box":{"x":363,"y":1040,"w":41,"h":16},"links":[]},{"t":"p","text":"25,000+","box":{"x":291,"y":1107,"w":185,"h":44},"links":[]},{"t":"p","text":"Clients","box":{"x":364,"y":1155,"w":40,"h":16},"links":[]},{"t":"p","text":"24/7","box":{"x":335,"y":1223,"w":98,"h":44},"links":[]},{"t":"p","text":"Support","box":{"x":361,"y":1271,"w":46,"h":16},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/j9wK2yytAe0bd94uN5DKBQxldw.png?width=1920&height=1080","alt":"Air blown micro fiber cable and microduct","box":{"x":-193,"y":1514,"w":1155,"h":410},"nat":[1155,649]},{"t":"p","text":"What it is","box":{"x":16,"y":1952,"w":736,"h":35},"links":[]},{"t":"p","text":"Blown installation puts the duct in first and the cable in later, which means the trench gets opened once. Micro cable is built small enough to be blown through a single way of a multi-way bundle, so one bore carries several routes and the spare ways sit there waiting for whatever the network needs in three years. The expensive part of outside plant is the digging, not the cable.","box":{"x":16,"y":2000,"w":736,"h":149},"links":[]},{"t":"p","text":"Product codes","box":{"x":38,"y":2195,"w":692,"h":20},"links":[]},{"t":"p","text":"Air blown micro cable, HDPE microduct bundle, CTC vault series","box":{"x":38,"y":2221,"w":692,"h":20},"links":[]},{"t":"p","text":"Fiber type","box":{"x":38,"y":2277,"w":692,"h":20},"links":[]},{"t":"p","text":"G.652D single-mode, G.657A1 available","box":{"x":38,"y":2303,"w":692,"h":20},"links":[]},{"t":"p","text":"Fiber counts","box":{"x":38,"y":2360,"w":692,"h":20},"links":[]},{"t":"p","text":"24F to 288F","box":{"x":38,"y":2386,"w":692,"h":20},"links":[]},{"t":"p","text":"Construction","box":{"x":38,"y":2442,"w":692,"h":20},"links":[]},{"t":"p","text":"Loose tube stranded micro, gel filled or dry, all-dielectric","box":{"x":38,"y":2468,"w":692,"h":20},"links":[]},{"t":"p","text":"Jacket and protection","box":{"x":38,"y":2525,"w":692,"h":20},"links":[]},{"t":"p","text":"HDPE, low friction sheath, water blocking","box":{"x":38,"y":2551,"w":692,"h":20},"links":[]},{"t":"p","text":"Deployment","box":{"x":38,"y":2607,"w":692,"h":20},"links":[]},{"t":"p","text":"Blown into microduct, direct buried duct, existing conduit","box":{"x":38,"y":2633,"w":692,"h":20},"links":[]},{"t":"p","text":"Lead time","box":{"x":38,"y":2690,"w":692,"h":20},"links":[]},{"t":"p","text":"6 to 8 weeks from PO, up to 10 weeks for custom builds","box":{"x":38,"y":2716,"w":692,"h":20},"links":[]},{"t":"p","text":"Duct sized to the cable, not the other way round","box":{"x":34,"y":2860,"w":700,"h":35},"links":[]},{"t":"p","text":"Bundles in 24 way and 25 way, individual ways from 5mm to 27mm OD, matched to the cable counts they carry.","box":{"x":34,"y":2923,"w":700,"h":56},"links":[]},{"t":"p","text":"24F","box":{"x":188,"y":3021,"w":37,"h":20},"links":[]},{"t":"p","text":"48F","box":{"x":543,"y":3021,"w":38,"h":20},"links":[]},{"t":"p","text":"72F","box":{"x":189,"y":3079,"w":35,"h":20},"links":[]},{"t":"p","text":"96F","box":{"x":543,"y":3079,"w":37,"h":20},"links":[]},{"t":"p","text":"144F","box":{"x":183,"y":3137,"w":47,"h":20},"links":[]},{"t":"p","text":"288F","box":{"x":537,"y":3137,"w":49,"h":20},"links":[]},{"t":"p","text":"Browse individual products","box":{"x":16,"y":3334,"w":736,"h":26},"links":[]},{"t":"a","href":"./products/air-blown-micro-cable","text":"Air blown micro cable","box":{"x":99,"y":3378,"w":165,"h":36}},{"t":"p","text":"Air blown micro cable","box":{"x":113,"y":3388,"w":137,"h":16},"links":[]},{"t":"a","href":"./products/hdpe-microduct-single-way","text":"HDPE microduct, single way","box":{"x":275,"y":3378,"w":206,"h":36}},{"t":"p","text":"HDPE microduct, single way","box":{"x":289,"y":3388,"w":178,"h":16},"links":[]},{"t":"a","href":"./products/hdpe-microduct-bundle","text":"HDPE microduct bundle","box":{"x":490,"y":3378,"w":178,"h":36}},{"t":"p","text":"HDPE microduct bundle","box":{"x":504,"y":3388,"w":150,"h":16},"links":[]},{"t":"a","href":"./products/composite-vault-heavy","text":"Composite vault, heavy (Tier 15)","box":{"x":52,"y":3424,"w":233,"h":36}},{"t":"p","text":"Composite vault, heavy (Tier 15)","box":{"x":66,"y":3434,"w":205,"h":16},"links":[]},{"t":"a","href":"./products/composite-vault-heavy-2","text":"Composite vault, heavy (Tier 22)","box":{"x":295,"y":3424,"w":235,"h":36}},{"t":"p","text":"Composite vault, heavy (Tier 22)","box":{"x":309,"y":3434,"w":207,"h":16},"links":[]},{"t":"a","href":"./products/composite-surface-box","text":"Composite surface box","box":{"x":540,"y":3424,"w":175,"h":36}},{"t":"p","text":"Composite surface box","box":{"x":554,"y":3434,"w":147,"h":16},"links":[]},{"t":"p","text":"Why source it through Vocom","box":{"x":16,"y":3624,"w":736,"h":35},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Build-to-order: specified to your route, count and jacket, not off a fixed shelf.","box":{"x":36,"y":3747,"w":696,"h":22},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Fujikura preform glass: tier 1 manufacturing, consistent quality.","box":{"x":36,"y":3860,"w":696,"h":22},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Lead times that move: supply when domestic loose-tube is quoted months out.","box":{"x":36,"y":3974,"w":696,"h":22},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Import/export handled: documentation, customs and delivery coordinated.","box":{"x":36,"y":4088,"w":696,"h":22},"links":[]},{"t":"svg","w":24},{"t":"p","text":"Founded in 1998: a supplier that also runs networks.","box":{"x":36,"y":4202,"w":696,"h":22},"links":[]},{"t":"p","text":"Air blown micro cable FAQ","box":{"x":16,"y":4351,"w":736,"h":35},"links":[]},{"t":"p","text":"How do I size microduct to my cable?","box":{"x":38,"y":4436,"w":692,"h":24},"links":[]},{"t":"p","text":"Match the way’s internal diameter to the cable OD with clearance for the blow. Ways run 5mm to 27mm OD in 24 way and 25 way bundles. Send the counts and the route length and we will spec the bundle with you.","box":{"x":38,"y":4470,"w":692,"h":74},"links":[]},{"t":"p","text":"Can micro cable be blown into existing conduit?","box":{"x":38,"y":4600,"w":692,"h":24},"links":[]},{"t":"p","text":"Yes, and that is often the point. A bundle placed inside an occupied conduit adds several routes without a new trench.","box":{"x":38,"y":4634,"w":692,"h":50},"links":[]},{"t":"p","text":"What vault ratings do you supply?","box":{"x":38,"y":4740,"w":692,"h":24},"links":[]},{"t":"p","text":"The CTC composite series to SCTE-77 Tier 15 and Tier 22. Composite rather than concrete, so a smaller crew places them and shipping costs less.","box":{"x":38,"y":4774,"w":692,"h":50},"links":[]},{"t":"p","text":"How quickly can you deliver?","box":{"x":38,"y":4880,"w":692,"h":24},"links":[]},{"t":"p","text":"6 to 8 weeks from PO, up to 10 weeks for custom builds. Micro cable is one of the tightest lines in the market right now, and most domestic quotes run considerably longer.","box":{"x":38,"y":4914,"w":692,"h":50},"links":[]},{"t":"h3","text":"What is fiber microduct?","box":{"x":38,"y":5019,"w":692,"h":24},"links":[]},{"t":"p","text":"Fiber microduct is small-diameter duct that is placed first, with microcable blown in later by compressed air. Fiber optic microduct lets a route be built in stages, adds cable only when demand arrives, and protects the cable once it is inside. Vocom supplies microduct for fiber optic cable alongside air blown micro cable, built to order in 6 to 8 weeks, up to 10 weeks for custom builds.","box":{"x":38,"y":5053,"w":692,"h":124},"links":[]},{"t":"p","text":"Need a Fiber Built to Your Exact Specification?","box":{"x":50,"y":5103,"w":668,"h":32},"links":[]},{"t":"p","text":"Fiber count, jacket, rating and connector, we can source and build any fiber optic cable to match your spec.","box":{"x":84,"y":5147,"w":600,"h":48},"links":[]},{"t":"a","href":"./contact-vocomai","text":"Talk to a Specifier","box":{"x":283,"y":5207,"w":202,"h":45}},{"t":"p","text":"Talk to a Specifier","box":{"x":305,"y":5222,"w":132,"h":15},"links":[]},{"t":"svg","w":17},{"t":"a","href":"./","text":"","box":{"x":60,"y":5427,"w":33,"h":35}},{"t":"img","src":"https://framerusercontent.com/images/TTIbUaJpCfUwzR62SUUmiGgRfM.png?width=226&height=243","alt":"Vocom logo","box":{"x":60,"y":5427,"w":33,"h":35},"nat":[226,243]},{"t":"p","text":"Your partner for telecommunications and fiber optic supply.","box":{"x":60,"y":5488,"w":648,"h":27},"links":[]},{"t":"a","href":"https://www.linkedin.com/company/vocomai","text":"","box":{"x":60,"y":5532,"w":35,"h":35}},{"t":"svg","w":35},{"t":"p","text":"Quick Links","box":{"x":60,"y":5615,"w":89,"h":27},"links":[]},{"t":"p","text":"VOCOM AI","box":{"x":60,"y":5658,"w":81,"h":27},"links":["./"]},{"t":"p","text":"Services","box":{"x":60,"y":5697,"w":66,"h":27},"links":["./vocom-services"]},{"t":"p","text":"RenOS AI Agents","box":{"x":60,"y":5736,"w":129,"h":27},"links":["./vocom-ai-agents"]},{"t":"p","text":"Resources","box":{"x":60,"y":5823,"w":81,"h":27},"links":[]},{"t":"p","text":"Resource Center","box":{"x":60,"y":5867,"w":127,"h":27},"links":["./resources"]},{"t":"p","text":"Blog","box":{"x":60,"y":5906,"w":34,"h":27},"links":["./blog"]},{"t":"p","text":"Company","box":{"x":404,"y":5615,"w":73,"h":27},"links":[]},{"t":"p","text":"About Us","box":{"x":404,"y":5658,"w":70,"h":27},"links":["./about"]},{"t":"p","text":"Contact Us","box":{"x":404,"y":5697,"w":84,"h":27},"links":["./contact-vocomai"]},{"t":"p","text":"Privacy Policy","box":{"x":404,"y":5736,"w":106,"h":27},"links":["./vocom-privacy-policy"]},{"t":"p","text":"© 2026. All rights reserve