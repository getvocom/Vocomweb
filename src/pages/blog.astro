---
// Converted from Framer by scripts/framer/compile.mjs, then maintained by hand.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getPosts, getProducts } from "../lib/cms";
import "../styles/pages/blog.css";
const posts = await getPosts();
---
<Base path="/blog">
<div class="desktop x18jjgv"><div class="site-header-slot header-slot" data-pagefind-ignore><Header /></div><div class="content xcunrfe"><main class="xgvleal"><div class="intro-header xwlszac"><h1 class="xiglghe">Fiber, Connectivity, and AI Insights</h1><h2 class="x3bs7si">Practical guidance on fiber optic cable specification, telecom infrastructure, and enterprise AI, from a team that has run networks since 1998.</h2></div><div class="xwqa03j">{posts.map((item) => (<a class="case-thumbnail xd0kq3e" href={"/blog/" + item.id}><div class="wrap xx9ppqb"><div class="image xdbmktu">{item.data.image?.src && <img class="fill-img fit" src={item.data.image.src} alt={item.data.image.alt ?? ""} loading="lazy" decoding="async"/>}</div><div class="xlw20n0"><div class="icon-arrow xzxipsl"><svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true"><path d="M 13.667 1.583 L 4 1.583 C 3.586 1.583 3.25 1.919 3.25 2.333 C 3.25 2.747 3.586 3.083 4 3.083 L 11.856 3.083 L 1.803 13.136 C 1.51 13.429 1.51 13.904 1.803 14.197 C 2.096 14.49 2.571 14.49 2.864 14.197 L 12.917 4.144 L 12.917 12 C 12.917 12.414 13.252 12.75 13.667 12.75 C 14.081 12.75 14.417 12.414 14.417 12 L 14.417 2.333 C 14.417 1.919 14.081 1.583 13.667 1.583 Z" fill="var(--icon-color, var(--white))"></path></svg></div></div></div><div class="description xxam86z"><p class="client-name xln6awk">{item.data.product}</p><div class="xjwpfji"><h3 class="xqbkdlg">{item.data.cardTitle}</h3></div></div></a>))}</div><div class="text-3-columns x6poghv"><p class="x6enb0u">Why We Write This</p><div class="x1z6ani"><p class="xkydvn6">We publish what we would want to read ourselves: specific, technical, and grounded in real deployments, not generic advice.</p><a class="button-icon xjazvom fb" href="/about"><p class="xpwacie">About Us</p><div class="icon-arrow xk2u4oo"><svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true"><path d="M 13.667 1.583 L 4 1.583 C 3.586 1.583 3.25 1.919 3.25 2.333 C 3.25 2.747 3.586 3.083 4 3.083 L 11.856 3.083 L 1.803 13.136 C 1.51 13.429 1.51 13.904 1.803 14.197 C 2.096 14.49 2.571 14.49 2.864 14.197 L 12.917 4.144 L 12.917 12 C 12.917 12.414 13.252 12.75 13.667 12.75 C 14.081 12.75 14.417 12.414 14.417 12 L 14.417 2.333 C 14.417 1.919 14.081 1.583 13.667 1.583 Z" fill="var(--icon-color, var(--white))"></path></svg></div></a></div></div></main></div><div class="simple-footer-2 xzxrxrs footer-slot" data-pagefind-ignore><Footer footerTagline="One Platform. One Partner. Future-Ready" title="Quick Links" menu1="VOCOM" menu2="Services" menu3="RenOS AI Agents" link1="/" link2="/vocom-services" link3="/vocom-ai-agents" /></div></div>
</Base>
