---
// Supplier comparison table (Tom, 2026-11-06), laid out like a plan comparison: grouped rows,
// text cells, the call to action in the Vocom column head. No pricing, by design.
// Competitor cells only state what a public source shows (see `sources`). Update CHECKED when they are re-checked.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FaqItem from "../components/FaqItem.astro";

const CHECKED = "November 6, 2026";
const CTA = "Get a Customized Quote Within 24hrs";
const NL = "Not listed";
const nl = [NL, NL, NL, NL];
const columns = ["Corning", "Prysmian", "Sumitomo Electric", "YOFC"];
const stats = [
  { value: "1993", label: "Founded" },
  { value: "25K+", label: "Clients" },
  { value: "100+", label: "Regions" },
  { value: "99.9%", label: "Uptime" },
  { value: "24/7", label: "Support" },
];
const groups = [
  { title: "Lead Times", rows: [
    { label: "Standard order", vocom: "6 to 8 weeks", others: nl },
    { label: "High-count or custom build", vocom: "Up to 10 weeks", others: nl },
    { label: "Expedited order", vocom: "2 to 3 weeks, air freight", others: nl },
    { label: "Quote response", vocom: "Within 24 hours", others: nl },
  ] },
  { title: "Fiber and Cable", rows: [
    { label: "Fiber types", vocom: "G.652D, G.657A1, G.657A2, OS2, OM3, OM4 and OM5", others: nl },
    { label: "Highest ribbon fiber count", vocom: "6912F", others: ["6912F", "6912F", "6912F", NL] },
    { label: "Outside plant", vocom: "Loose tube, ADSS, figure 8, armored direct burial, hybrid fiber and copper", others: nl },
    { label: "Ribbon", vocom: "Rollable, flat and central tube", others: nl },
    { label: "Air blown", vocom: "Micro cable, HDPE microduct and vaults", others: nl },
    { label: "FTTH and drop", vocom: "Flat and armored drop, OptiTap compatible connectors", others: nl },
    { label: "Indoor and data center", vocom: "OFNP plenum, OFNR riser, MPO and MTP trunks, cassettes, harnesses", others: nl },
    { label: "Connectors and hardware", vocom: "Patch cords, adapters, terminal boxes", others: nl },
    { label: "Glass", vocom: "Fujikura preform", others: nl },
    { label: "Quality", vocom: "Quality-checked per order, test data on request", others: nl },
  ] },
  { title: "Buying", rows: [
    { label: "Company type", vocom: "Supplier. Cable is built to order by tier 1 manufacturers", others: ["Manufacturer", "Manufacturer", "Manufacturer", "Manufacturer"] },
    { label: "Ownership", vocom: "Private and self-funded", others: ["Publicly listed", "Publicly listed", "Publicly listed", "Publicly listed"] },
    { label: "How to buy", vocom: "Direct, from one quote request", others: ["Sales representative or authorized distributor", "Sales team", "Distributor or regional sales manager", "Sales network"] },
    { label: "Stock model", vocom: "Built to order, no warehouse", others: nl },
    { label: "Second source for your spec", vocom: "Yes", others: nl },
    { label: "Minimum order", vocom: "Confirmed with your quote", others: nl },
    { label: "Delivery split across ship dates", vocom: "Yes", others: nl },
    { label: "Delivery terms", vocom: "FOB or DDP, quoted by destination", others: nl },
    { label: "Import and export paperwork", vocom: "Documentation and customs coordinated", others: nl },
  ] },
  { title: "Geographies", rows: [
    { label: "Company base", vocom: "El Monte, California and Taipei", others: ["Corning, New York", "Milan, Italy", "Osaka, Japan", "Wuhan, China"] },
    { label: "Regions served", vocom: "US and Canada, plus import and export across 100+ regions", others: ["Americas, EMEA and Asia Pacific, through regional distributors", "Global, with a North America business", "The Americas, through Sumitomo Electric Lightwave", "Global, through a sales network"] },
  ] },
  { title: "Customer Support", rows: [
    { label: "Coverage", vocom: "24/7 support", others: ["Customer service line, 24x7 for in-building networks", "24/7 emergency order line", NL, NL] },
    { label: "Who answers", vocom: "An engineer or account manager, not a ticket queue", others: nl },
  ] },
  { title: "Telecom Services", rows: [
    { label: "Carrier license", vocom: "FCC 214 licensed since 1998", others: nl },
    { label: "Private circuits", vocom: "IEPL and IPLC across the Pacific", others: nl },
    { label: "Data services", vocom: "IP transit, MPLS-VPN and Anti-DDoS", others: nl },
    { label: "Wholesale voice", vocom: "IDD and SMS on direct NNI routes", others: nl },
    { label: "Network monitoring", vocom: "24/7 NOC", others: nl },
  ] },
  { title: "AI Solutions", rows: [
    { label: "AI agents", vocom: "RenOS, governed agents across any model", others: nl },
    { label: "AI tools by job", vocom: "Supply chain, manufacturing, coaching and network security", others: nl },
    { label: "AI infrastructure", vocom: "AI servers and GPU solutions", others: nl },
    { label: "AI consulting", vocom: "Yes", others: nl },
  ] },
];
const sources = [
  { label: "Corning: how to buy", href: "https://www.corning.com/cala/en/products/communication-networks/how-to-buy.html" },
  { label: "Corning: RocketRibbon cable", href: "https://www.corning.com/optical-communications/worldwide/en/home/products/fiber-optic-cable/outdoor-cables/rocket-ribbon.html" },
  { label: "Prysmian North America: optical fiber made in the USA", href: "https://na.prysmian.com/markets/digital-solutions/optical-fiber/made-right-here" },
  { label: "Prysmian North America: 6912F MassLink with FlexRibbon", href: "https://na.prysmian.com/576-6912f-masslink-flexribbon-multi-tube-na-200um" },
  { label: "Sumitomo Electric Lightwave: about and how to buy", href: "https://sumitomoelectriclightwave.com/about/" },
  { label: "Sumitomo Electric: high fiber count cables", href: "https://sumitomoelectric.com/products/optical-cables/highfibercount" },
  { label: "YOFC: company website", href: "https://en.yofc.com/" },
  { label: "Corning: in-building networks support", href: "https://www.corning.com/in-building-networks/cala/en/home/support-center.html" },
  { label: "Prysmian: emergency order line (2022)", href: "https://stocks.observer-reporter.com/observerreporter/article/accesswire-2022-6-14-prysmian-groups-emergency-order-line-offers-immediate-solutions-in-wake-of-natural-disasters" },
];
---
<Base path="/fiber-optic-cable-supplier-comparison">
  <div class="cmp-page">
    <div class="site-header-slot"><Header /></div>
    <main class="cmp-main">
      <section class="cmp-hero">
        <h1>Fiber Optic Cable Suppliers Compared</h1>
        <p>Lead times, fiber, buying, geographies, support and services, for Vocom, Corning, Prysmian, Sumitomo Electric and YOFC. Our answers are public. There's no pricing here because bulk cable is quoted per order.</p>
        <a class="cmp-btn" href="/contact-vocomai">{CTA}</a>
      </section>

      <ul class="cmp-stats">
        {stats.map((x) => <li><strong>{x.value}</strong><span>{x.label}</span></li>)}
      </ul>

      <div class="cmp-picker" role="group" aria-label="Compare Vocom with" hidden>
        <span>Compare Vocom with</span>
        {columns.map((c, i) => <button type="button" data-col={i} aria-pressed={i === 0 ? "true" : "false"}>{c}</button>)}
      </div>

      <div class="cmp-wrap">
        <table class="cmp-table">
          <caption class="cmp-sr">Fiber optic cable supplier comparison, checked {CHECKED}</caption>
          <thead>
            <tr>
              <td class="cmp-corner"></td>
              <th scope="col" class="cmp-vocom"><span>Vocom</span><small>Since 1993</small><a class="cmp-btn cmp-btn-sm" href="/contact-vocomai">Get a Quote</a></th>
              {columns.map((c) => <th scope="col"><span>{c}</span></th>)}
            </tr>
          </thead>
          {groups.map((g) => (
            <tbody>
              <tr class="cmp-group"><th scope="colgroup" colspan={columns.length + 2}><h2>{g.title}</h2></th></tr>
              {g.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td class="cmp-vocom">{r.vocom}</td>
                  {r.others.map((v) => <td class={v === NL ? "cmp-np" : undefined}>{v}</td>)}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>

      <p class="cmp-note">"Not listed" means we couldn't find it on that company's public website when we checked on {CHECKED}. It doesn't mean they can't do it, and these companies carry broad catalogs.</p>

      <section class="cmp-cta">
        <h2>{CTA}</h2>
        <p>Send the cable type, fiber count, quantity and delivery location. We'll confirm price and lead time against your actual specification. Already holding a quote? Send it over and put ours next to it.</p>
        <a class="cmp-btn" href="/contact-vocomai">Request a Quote</a>
      </section>

      <section class="cmp-faq">
        <h2>Frequently Asked Questions</h2>
        <FaqItem question="How do Vocom's lead times compare with Corning, Prysmian, Sumitomo Electric and YOFC?">Vocom's standard build-to-order lead time is 6 to 8 weeks, up to 10 weeks for high-count or custom builds, and 2 to 3 weeks for expedited orders by air freight. We couldn't find a public lead time from the other four.</FaqItem>
        <FaqItem question="Does Vocom manufacture fiber optic cable?">No. Cable is produced to specification by tier 1 manufacturing partners on Fujikura preform glass. Vocom handles specification, sourcing, build-to-order coordination and delivery.</FaqItem>
        <FaqItem question="Why is there no pricing in this comparison?">Price depends on the fiber count, fiber type, construction, order quantity and delivery location, so bulk cable is quoted per order. Send us your specification and we'll confirm price and lead time together.</FaqItem>
      </section>

      <section class="cmp-sources">
        <h2>Sources</h2>
        <ul>
          {sources.map((s) => <li><a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}
        </ul>
        <p>Compiled from public sources, checked {CHECKED}. Company details change, so confirm them with each company before you buy. Corning, Prysmian, Sumitomo Electric and YOFC are trademarks of their respective owners. Vocom isn't affiliated with or endorsed by them. If something here is out of date, tell us at <a href="mailto:kevin@getvocom.com">kevin@getvocom.com</a> and we'll correct it.</p>
      </section>
    </main>
    <div class="cmp-footer"><Footer /></div>
  </div>
</Base>

<script>
  // Phone view: Vocom against one company at a time. Without JavaScript the full table scrolls instead.
  const table = document.querySelector<HTMLElement>(".cmp-table");
  const picker = document.querySelector<HTMLElement>(".cmp-picker");
  if (table && picker) {
    const buttons = picker.querySelectorAll<HTMLButtonElement>("button");
    table.dataset.col = "0";
    picker.hidden = false;
    buttons.forEach((b) => b.addEventListener("click", () => {
      table.dataset.col = b.dataset.col;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }));
  }
</script>

<style>
  .cmp-page { display: flex; flex-direction: column; align-items: center; min-height: 100vh; background: var(--white); }
  .cmp-main { width: 100%; max-width: 1200px; padding: 96px 24px 80px; display: flex; flex-direction: column; gap: 48px; font-family: var(--font-sans); color: var(--ink-heading); }
  .cmp-footer { width: 100%; }
  .cmp-hero { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; max-width: 820px; margin: 0 auto; }
  .cmp-hero h1 { font-family: var(--font-display); font-weight: 600; font-size: 56px; line-height: 1.1; letter-spacing: -0.03em; }
  .cmp-hero p, .cmp-cta p { font-size: 18px; line-height: 1.55; color: var(--gray-600); }
  .cmp-btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 24px; border-radius: var(--radius-pill); background: var(--color-vocom-cta-1); color: var(--white); font-weight: 600; font-size: 16px; text-decoration: none; text-align: center; }
  .cmp-btn:hover { background: var(--color-vocom); }
  .cmp-btn-sm { padding: 8px 14px; font-size: 13px; white-space: nowrap; }

  .cmp-stats { list-style: none; margin: 0; padding: 24px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; text-align: center; border-radius: var(--radius-lg); background: var(--brand-pink-50); border: 1px solid var(--brand-pink-border); }
  .cmp-stats strong { display: block; font-family: var(--font-display); font-size: 32px; line-height: 1.2; font-weight: 600; color: var(--color-vocom-cta-1); }
  .cmp-stats span { font-size: 14px; color: var(--gray-600); }

  .cmp-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .cmp-table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 14px; line-height: 1.45; }
  .cmp-table th, .cmp-table td { padding: 14px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-gray-4); overflow-wrap: break-word; background: var(--white); }
  .cmp-table thead th, .cmp-table .cmp-corner { position: sticky; top: 84px; z-index: 2; vertical-align: bottom; border-bottom: 2px solid var(--ink-heading); box-shadow: 0 -84px 0 var(--white); }
  .cmp-table thead th span { display: block; font-size: 16px; font-weight: 600; }
  .cmp-table thead small { display: block; font-size: 12px; font-weight: 500; color: var(--gray-600); }
  .cmp-table thead .cmp-btn { margin-top: 8px; }
  .cmp-table .cmp-corner { width: 18%; }
  .cmp-table thead th.cmp-vocom { width: 26%; }
  .cmp-table tbody th[scope="row"] { font-weight: 500; color: var(--ink-heading); }
  .cmp-table .cmp-group th { padding: 32px 12px 10px; border-bottom: 1px solid var(--ink-heading); }
  .cmp-table .cmp-group h2 { font-family: var(--font-display); font-size: 22px; font-weight: 600; }
  .cmp-table .cmp-vocom { background: var(--brand-pink-50); font-weight: 500; }
  .cmp-table .cmp-np { color: var(--gray-500); }
  .cmp-note { font-size: 14px; line-height: 1.55; color: var(--gray-600); max-width: 820px; }

  .cmp-cta { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding: 48px 24px; border-radius: var(--radius-lg); background: var(--brand-pink-50); border: 1px solid var(--brand-pink-border); }
  .cmp-cta h2, .cmp-faq h2 { font-family: var(--font-display); font-size: 36px; line-height: 1.15; font-weight: 600; }
  .cmp-faq { display: flex; flex-direction: column; gap: 12px; max-width: 820px; width: 100%; margin: 0 auto; }
  .cmp-faq h2 { margin-bottom: 12px; text-align: center; }
  .cmp-sources { display: flex; flex-direction: column; gap: 10px; font-size: 13px; line-height: 1.55; color: var(--gray-600); border-top: 1px solid var(--color-gray-4); padding-top: 24px; }
  .cmp-sources h2 { font-size: 16px; font-weight: 600; color: var(--ink-heading); }
  .cmp-sources ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .cmp-sources a { color: inherit; text-decoration: underline; }

  /* Clears the 84px white backing on the sticky table head, which would otherwise cover the stats. */
  @media (min-width: 1200px) { .cmp-wrap { margin-top: 40px; } }

  /* Below desktop the table scrolls inside its own box; the row labels stay in view. */
  @media (max-width: 1199.98px) {
    .cmp-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .cmp-table { min-width: 1040px; }
    .cmp-table thead th, .cmp-table .cmp-corner { position: static; top: auto; box-shadow: none; }
    .cmp-table tbody th[scope="row"], .cmp-table .cmp-corner { position: sticky; left: 0; z-index: 1; }
    .cmp-table .cmp-group th { position: static; }
    .cmp-table .cmp-group h2 { position: sticky; left: 12px; display: inline-block; }
  }
  @media (max-width: 809.98px) {
    .cmp-main { padding: 72px 16px 56px; gap: 36px; }
    .cmp-hero h1 { font-size: 36px; }
    .cmp-hero p, .cmp-cta p { font-size: 16px; }
    .cmp-stats { grid-template-columns: repeat(3, 1fr); padding: 16px; }
    .cmp-stats strong { font-size: 24px; }
    .cmp-cta h2, .cmp-faq h2 { font-size: 28px; }
    .cmp-table { min-width: 820px; font-size: 13px; }
    .cmp-table[data-col] { min-width: 0; table-layout: auto; }
    .cmp-table[data-col] thead th, .cmp-table[data-col] thead th.cmp-vocom, .cmp-table[data-col] .cmp-corner, .cmp-table[data-col] tbody tr:not(.cmp-group) > * { width: 33.33%; }
    .cmp-table[data-col] tr > :nth-child(n+3) { display: none; }
    .cmp-table[data-col="0"] tr > :nth-child(3),
    .cmp-table[data-col="1"] tr > :nth-child(4),
    .cmp-table[data-col="2"] tr > :nth-child(5),
    .cmp-table[data-col="3"] tr > :nth-child(6) { display: table-cell; }
    .cmp-table[data-col] tbody th[scope="row"], .cmp-table[data-col] .cmp-corner { position: static; }
    .cmp-table[data-col] th, .cmp-table[data-col] td { padding: 12px 8px; }
    .cmp-table[data-col] .cmp-group h2 { position: static; }
    .cmp-picker:not([hidden]) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: -20px; }
    .cmp-picker span { width: 100%; font-size: 14px; font-weight: 500; }
    .cmp-picker button { padding: 8px 14px; border-radius: var(--radius-pill); border: 1px solid var(--color-gray-4); background: var(--white); color: var(--ink-heading); font: inherit; font-size: 13px; cursor: pointer; }
    .cmp-picker button[aria-pressed="true"] { background: var(--color-vocom-cta-1); border-color: var(--color-vocom-cta-1); color: var(--white); }
  }
  @media (min-width: 810px) { .cmp-picker { display: none; } }
</style>
