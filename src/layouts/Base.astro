---
// Shared page shell: SEO head, tracking, site-wide JSON-LD and the cookie banner.
// Static pages read their SEO fields from src/data/head/<key>.json (copied verbatim
// from the live Framer site). CMS templates pass `seo` to override per entry.
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";
import NewsletterPopup from "../components/NewsletterPopup.astro";
import { headFor, splitJsonLd, type HeadData } from "../lib/head";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { NAV } from "../lib/nav";

interface Props {
  path: string;
  seo?: Partial<HeadData> & Record<string, unknown>;
  noindex?: boolean;
}
const { path, seo, noindex = false } = Astro.props;
const head = headFor(path, seo);
const { page: pageLd, site: siteLd } = splitJsonLd(head.jsonld);
// BreadcrumbList schema for pages that don't render their own trail (product pages and
// /case-studies do): Home > nav section > page, or Home > Blog > post.
const pageName = head.title.replace(/\s*[|].*$/, "").trim();
let crumbs: [string, string][] | undefined;
if (path.startsWith("/blog/")) crumbs = [["Home", "/"], ["Blog", "/blog"], [pageName, path]];
else if (path !== "/" && !path.startsWith("/products/") && path !== "/case-studies" && !head.jsonld.some((j) => j.includes("BreadcrumbList"))) {
  const section = NAV.find((s) => s.href === path || s.groups.some((g) => g.links.some((l) => l.href === path)));
  const link = NAV.flatMap((s) => s.groups.flatMap((g) => g.links)).find((l) => l.href === path);
  if (section) crumbs = section.href === path ? [["Home", "/"], [section.label, path]] : [["Home", "/"], [section.label, section.href], [link?.label ?? pageName, path]];
}
---
<!doctype html>
<html lang={head.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{head.title}</title>
    {head.links.filter((l) => l.rel === "canonical").map((l) => <link rel="canonical" href={l.href} />)}
    {head.meta.map((m) => ("name" in m ? <meta name={m.name} content={m.content} /> : <meta property={m.property} content={m.content} />))}
    {head.links.filter((l) => l.rel !== "canonical").map((l) => <link rel={l.rel} href={l.href} media={l.media} />)}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    {pageLd.map((j) => <script type="application/ld+json" set:html={j} />)}
    {crumbs && <Breadcrumbs items={crumbs} visible={false} />}

    <!-- Google Analytics 4 (G-YYWN6PCL75) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YYWN6PCL75"></script>
    <script is:inline>
