---
// One page per data center region and per site (Tom, 2026-11-24): /data-centers/<slug>, slugs in
// src/data/data-centers.ts. Kevin's rule applies (notes/flags.md, 2026-11-24): region and headline specs
// only. No price, exact location, site photos (the photos are stock), seller names or unconfirmed
// availability. Every fact comes from SITES or from copy already on /data-centers, /buy-a-data-center
// and /data-center-colocation. The form (DcPage) posts as "Data Center"; /data-centers/* is allowed in
// QUOTE_PAGES in apps-script/Code.gs.
import DcPage from "../../components/DcPage.astro";
import FaqItem from "../../components/FaqItem.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { SITES, PATHS, CAVEAT, GALLERY, type Site } from "../../data/data-centers";

type Region = (typeof SITES)[number];
type Props = { kind: "region"; region: Region } | { kind: "site"; region: Region; site: Site; index: number };

export function getStaticPaths() {
  let i = 0;
  return SITES.flatMap((region) => [
    { params: { slug: region.slug }, props: { kind: "region", region } },
    ...region.sites.map((site) => ({ params: { slug: site.slug }, props: { kind: "site", region, site, index: i++ } })),
  ]);
}

const props = Astro.props as Props;
const { region } = props;
const SITE_URL = "https://www.vocom.ai";
const path = `/data-centers/${props.kind === "region" ? region.slug : props.site.slug}`;
const inRegion = { "United States": "the United States", "Middle East": "the Middle East" }[region.region] ?? region.region;
const place = (s: Site) => s.location.replace(/ campus$/, "");
const sentence = (t: string) => (t ? t.replace(/\.?$/, ".") : "");
// How each site is offered, only where an existing page already says so.
const ROUTE: Record<string, string> = {
  "north-dakota-data-center-campus": "For sale",
  "hickory-north-carolina-data-center": "Sale, lease or colocation",
  "dubai-data-center": "Colocation",
  "rayong-thailand-data-center-campus": "Lease, containerized 5MW units",
  "rayong-thailand-edge-data-center": "Lease",
  "sydney-data-center": "Lease",
};
const ROUTE_LINK: Record<string, [string, string]> = {
  "For sale": ["/buy-a-data-center", "Buy a data center"],
  Colocation: ["/data-center-colocation", "Lease and colocation"],
  Lease: ["/data-center-colocation", "Lease and colocation"],
};
const routeLink = (r?: string) => (r ? ROUTE_LINK[r] ?? (r.startsWith("Lease") ? ROUTE_LINK.Lease : r.startsWith("Sale") ? ROUTE_LINK["For sale"] : undefined) : undefined);

// capacity range for a region, e.g. "200MW to 1.2GW"
const mw = (c: string) => [...c.matchAll(/([\d.]+)\s*(MW|GW)/g)].map((m) => +m[1] * (m[2] === "GW" ? 1000 : 1));
const fmt = (n: number) => (n >= 1000 ? `${+(n / 1000).toFixed(1)}GW` : `${n}MW`);
const all = region.sites.flatMap((s) => mw(s.capacity));
const range = `${fmt(Math.min(...region.sites.map((s) => mw(s.capacity)[0])))} to ${fmt(Math.max(...all))}`;
const names = (list: string[]) => (list.length < 2 ? list.join("") : `${list.slice(0, -1).join(", ")} and ${list.at(-1)}`);
const otherRegions = SITES.filter((r) => r !== region);

const sendLine = "Use the form on this page, or email kevin@vocom.com with the buyer or tenant, the megawatts needed and the target date. The NDA comes first, then the site pack.";
let faqs: [string, string][];
let page: { eyebrow: string; title: string; lede: string; chips: string[]; stats: [string, string][]; metaTitle: string; description: string; photo: (typeof GALLERY)[number] };

if (props.kind === "region") {
  const locs = region.sites.map((s) => place(s));
  page = {
    eyebrow: `Data center sites in ${inRegion}`,
    title: `Data Center Sites in ${inRegion}: Buy, Lease or Build`,
    lede: `${region.sites.length === 1 ? "One site" : `${region.sites.length} sites`} in ${inRegion}, ${region.sites.length === 1 ? region.sites[0].capacity : `from ${range}`}: ${names(locs)}. Vocom introduces qualified buyers and tenants to the owners, and supplies the servers, fiber and optics that go inside.`,
    chips: [`${region.sites.length} ${region.sites.length === 1 ? "site" : "sites"}`, region.sites.length === 1 ? region.sites[0].capacity : range, "Buy, lease or build", "Site packs under NDA"],
    stats: [[String(region.sites.length), region.sites.length === 1 ? "Site listed" : "Sites listed"], [region.sites.length === 1 ? region.sites[0].capacity : fmt(Math.max(...all)), "Largest site"], ["4 to 9 mo", "Typical time to buy"], ["1 to 6 mo", "To go live in ready space"]],
    metaTitle: `Data Center Sites in ${inRegion}: Buy, Lease or Build | Vocom`,
    description: `Data center sites in ${inRegion}: ${names(region.sites.map((s) => `${place(s)} (${s.capacity})`))}. Site packs under NDA.`,
    photo: GALLERY[SITES.indexOf(region) % GALLERY.length],
  };
  faqs = [
    [`Which data center sites does Vocom list in ${inRegion}?`, `${names(region.sites.map((s) => `${place(s)}, ${s.capacity}`))}. Each site has its own page with the headline specs.`],
    ["Can I see exact locations and pricing?", "Yes, once an NDA is in place. Publicly we list the region and headline specs only. Pricing, the exact location and the site documents go to qualified buyers and tenants with the site pack."],
    ["Can I buy, lease or build on these sites?", "It depends on the owner. Some sites are for sale, some offer colocation or long-term leases, and some are land with power for a new build. Tell us what you need and we will say which sites fit."],
    ["Are the capacity figures confirmed?", CAVEAT],
    ["How do I request a site pack?", sendLine],
  ];
} else {
  const s = props.site;
  const route = ROUTE[s.slug];
  page = {
    eyebrow: `Data center site in ${inRegion}`,
    title: `${place(s)} Data Center Site: ${s.capacity}`,
    lede: `${s.summary ?? `A ${s.capacity} data center site in ${place(s)}. ${sentence(s.notes)}`.trim()} Vocom introduces qualified buyers and tenants to the owner. The exact location, pricing and site documents are shared under NDA.`,
    chips: [s.capacity, place(s), route ?? "Ask about buy, lease or build", "Site pack under NDA"],
    stats: [[s.capacity, "Site capacity"], [region.region === "Southeast Asia and Australia" ? "SE Asia" : region.region === "United States" ? "US" : region.region, "Region"], ["NDA", "Before location and price"], ["1 team", "Space, servers, fiber and optics"]],
    metaTitle: `${place(s)} Data Center: ${s.capacity} Site | Vocom`,
    description: `${s.capacity} data center site in ${place(s)}. ${sentence(s.notes)} Location, pricing and site pack under NDA.`.replace(/\s+/g, " "),
    photo: GALLERY[props.index % GALLERY.length],
  };
  faqs = [
    [`Where exactly is the ${place(s)} site?`, `We publish the region and headline specs only. The exact location goes to qualified buyers and tenants under NDA, together with the site pack.`],
    [`Can I buy or lease the ${place(s)} site?`, route ? `The owner offers it as: ${route.toLowerCase()}. Terms, pricing and timing come with the site pack under NDA.` : "It depends on the owner. Tell us whether you want to buy, lease or build and we will confirm what the owner offers, with terms in the site pack under NDA."],
    ["Are the capacity figures confirmed?", CAVEAT],
    ["Can Vocom supply the servers, optics and fiber?", "Yes. Vocom supplies Supermicro AI servers, optical transceivers and fiber cabling, so the space and what goes inside it can come from one team."],
    ["How do I request the site pack?", sendLine],
  ];
}

const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) });
const crumbs: [string, string][] = props.kind === "region"
  ? [["Home", "/"], ["Data Center Sites", "/data-centers"], [region.region, path]]
  : [["Home", "/"], ["Data Center Sites", "/data-centers"], [region.region, `/data-centers/${region.slug}`], [place(props.site), path]];
const seo = { title: page.metaTitle, description: page.description, canonical: SITE_URL + path, image: `${SITE_URL}/assets/img/dc-stock/${page.photo.name}-1024.jpg`, jsonld: [faqLd] };
const email = (t: string) => t.replace("kevin@vocom.com", '<a class="text-link" href="mailto:kevin@vocom.com">kevin@vocom.com</a>');
---
<DcPage path={path} seo={seo} eyebrow={page.eyebrow} title={page.title} lede={page.lede}
  photo={page.photo.name} photoAlt={page.photo.alt} panelTitle={props.kind === "site" ? "Headline specs" : `Sites in ${inRegion}`}
  chips={page.chips} stats={page.stats}
  secondary={props.kind === "site" ? [`/data-centers/${region.slug}`, `All sites in ${inRegion}`] : ["#sites", "See the sites"]}
  quoteTitle={props.kind === "site" ? "Ask for the Site Pack" : undefined}
  quoteIntro={props.kind === "site" ? `Tell us the buyer or tenant, the megawatts and the timing. Qualified requests get the ${place(props.site)} site pack under NDA.` : undefined}>
  <Breadcrumbs items={crumbs} visible={false} />

  {props.kind === "site" ? (
    <section class="dc-section">
      <h2>Headline Specs</h2>
      <p class="dc-sub">What we can publish about this site. Everything else comes with the site pack under NDA.</p>
      <div class="dc-table-wrap">
        <table class="dc-table">
          <tbody>
            <tr><th scope="row">Region</th><td><a class="text-link" href={`/data-centers/${region.slug}`}>{region.region}</a></td></tr>
            <tr><th scope="row">Area</th><td>{place(props.site)}</td></tr>
            <tr><th scope="row">Capacity</th><td>{props.site.capacity}</td></tr>
            {props.site.detail ? props.site.detail.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>) : props.site.notes && <tr><th scope="row">Notes</th><td>{sentence(props.site.notes)}</td></tr>}
            {!props.site.detail?.some(([k]) => k === "Structure") && <tr><th scope="row">Offered as</th><td>{ROUTE[props.site.slug] ? (routeLink(ROUTE[props.site.slug]) ? <a class="text-link" href={routeLink(ROUTE[props.site.slug])![0]}>{ROUTE[props.site.slug]}</a> : ROUTE[props.site.slug]) : "Confirmed with the owner: ask which routes fit"}</td></tr>}
            <tr><th scope="row">Location, price, photos</th><td>Under NDA</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <section class="dc-section" id="sites">
      <h2>Sites in {inRegion}</h2>
      <p class="dc-sub">Headline specs for each site. Open a site for its page, or ask for the site packs under NDA.</p>
      <div class="dc-grid">
        {region.sites.map((s) => (
          <a class="dc-card" href={`/data-centers/${s.slug}`}><span class="dc-tag">{s.capacity}</span><h3>{place(s)}</h3><p>{sentence(s.notes) || "Headline specs and site pack on request."}</p><span class="dc-more">View site &rarr;</span></a>
        ))}
      </div>
    </section>
  )}

  <section class="dc-section">
    <h2>How It Works</h2>
    <p class="dc-sub">Vocom introduces qualified buyers and tenants to the owner, coordinates diligence and supplies what goes inside.</p>
    <div class="dc-grid">
      <div class="dc-card"><span class="dc-tag">Step 1</span><h3>Tell Us the Requirement</h3><p>The buyer or tenant, the megawatts needed and the target date.</p></div>
      <div class="dc-card"><span class="dc-tag">Step 2</span><h3>NDA, Then the Site Pack</h3><p>Exact location, pricing, power documents and photos go to qualified requests under NDA.</p></div>
      <div class="dc-card"><span class="dc-tag">Step 3</span><h3>Diligence and Fit-Out</h3><p>Figures are checked in diligence. Servers, optics and fiber can come on one order from Vocom.</p></div>
    </div>
  </section>

  {props.kind === "site" && region.sites.length > 1 && (
    <section class="dc-section">
      <h2>Other Sites in {inRegion}</h2>
      <div class="dc-grid">
        {region.sites.filter((s) => s.slug !== props.site.slug).map((s) => (
          <a class="dc-card" href={`/data-centers/${s.slug}`}><span class="dc-tag">{s.capacity}</span><h3>{place(s)}</h3><span class="dc-more">View site &rarr;</span></a>
        ))}
      </div>
    </section>
  )}

  <section class="dc-section">
    <h2>Buy, Lease or Build</h2>
    <div class="dc-grid">
      {PATHS.map((p) => (
        <a class="dc-card" href={p.href}><span class="dc-tag">{p.time}</span><h3>{p.title}</h3><p>{p.body}</p><span class="dc-more">{p.title === "Lease" ? "Lease and colocation" : `${p.title} a data center`} &rarr;</span></a>
      ))}
    </div>
  </section>

  <section class="dc-section">
    <h2>Sites in Other Regions</h2>
    <div class="dc-grid">
      {otherRegions.map((r) => (
        <a class="dc-card" href={`/data-centers/${r.slug}`}><span class="dc-tag">{r.sites.length} {r.sites.length === 1 ? "site" : "sites"}</span><h3>{r.region}</h3><span class="dc-more">View sites &rarr;</span></a>
      ))}
    </div>
    <p class="dc-note">Own a site or represent a buyer? See <a class="text-link" href="/data-center-partners">working with Vocom on data centers</a>.</p>
  </section>

  <section class="dc-section">
    <h2>Frequently Asked Questions</h2>
    <div class="dc-faq">
      {faqs.map(([q, a]) => <FaqItem question={q}><Fragment set:html={email(a)} /></FaqItem>)}
    </div>
  </section>
</DcPage>
