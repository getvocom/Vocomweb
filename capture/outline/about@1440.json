[]},{"t":"svg","w":36},{"t":"img","src":"https://framerusercontent.com/images/0MPMpDEjwAlMr1CKIPyoyYJng30.jpg?scale-down-to=1024&width=1280&height=960","alt":"Vocom AI enterprise tools for coaching, security, and supply chain","box":{"x":754,"y":1425,"w":279,"h":214},"nat":[625,468]},{"t":"p","text":"Vocom AI","box":{"x":767,"y":1657,"w":270,"h":45},"links":[]},{"t":"p","text":"Enterprise AI across coaching, security, supply chain, and infrastructure, deployed without the wait.","box":{"x":768,"y":1691,"w":274,"h":123},"links":[]},{"t":"h3","text":"Why Choose Vocom?","box":{"x":410,"y":1993,"w":620,"h":46},"links":[]},{"t":"p","text":"Three business lines, one standard of reliability.","box":{"x":410,"y":2048,"w":620,"h":31},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/vdRBiUWibYVgoz1s0tFBBAh22M.jpg?width=1280&height=1920","alt":"Fiber optic cable spool for wholesale supply","box":{"x":120,"y":2119,"w":608,"h":200},"nat":[1199,1799]},{"t":"p","text":"Fiber Optic Cable","box":{"x":760,"y":2161,"w":560,"h":31},"links":[]},{"t":"p","text":"Wholesale cable built to order, with 6 to 8 week standard lead times, up to 10 weeks for high-count or custom builds, and 2 to 3 week expedited air freight available.","box":{"x":760,"y":2195,"w":560,"h":82},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/01JZb5pUjPG1mrIL4SASvThP1o.jpg?width=1280&height=686","alt":"Vocom AI enterprise tools for coaching, security, and supply chain","box":{"x":120,"y":2343,"w":608,"h":200},"nat":[1199,643]},{"t":"p","text":"Vocom AI","box":{"x":760,"y":2398,"w":560,"h":31},"links":[]},{"t":"p","text":"No-code enterprise AI for coaching, security, supply chain, and infrastructure, deployed fast.","box":{"x":760,"y":2433,"w":560,"h":54},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/7cQaBn1hRNuhW4DdemNVeQ9LM.jpg?width=1920&height=1280","alt":"Vocom International global telecom network connectivity","box":{"x":120,"y":2567,"w":608,"h":200},"nat":[1200,800]},{"t":"p","text":"Vocom International","box":{"x":760,"y":2622,"w":560,"h":31},"links":[]},{"t":"p","text":"Global telecom services connecting enterprises across Asia, the Middle East, Europe, and beyond.","box":{"x":760,"y":2657,"w":560,"h":54},"links":[]},{"t":"p","text":"Leadership","box":{"x":680,"y":2927,"w":80,"h":15},"links":[]},{"t":"p","text":"Meet the Team","box":{"x":24,"y":2954,"w":1392,"h":53},"links":[]},{"t":"p","text":"👤","box":{"x":330,"y":3160,"w":100,"h":120},"links":[]},{"t":"p","text":"Victor Huang","box":{"x":530,"y":3047,"w":640,"h":29},"links":[]},{"t":"p","text":"Founder, Vocom International","box":{"x":530,"y":3083,"w":640,"h":21},"links":[]},{"t":"p","text":"Victor Huang is the founder of Vocom International Telecommunications, Inc. He founded Vocom in Taipei in 1993, later expanding into Shenzhen and helping China Mobile, China Telecom, and China Unicom establish their early international operations. In 1998, Victor incorporated Vocom in the U.S., building it into a facilities-based carrier operating under license from the FCC’s International Bureau. Over more than three decades, he has worked with carrier partners on every continent except Antarctica, and Vocom today routes voice, data, fiber, mobile, and AI infrastructure for partner carriers across six continents, from wholesale IDD termination in 1998 to Supermicro AI compute today. Vocom remains entirely self-funded, running a modern facility staffed by an in-house team of telecom engineers trained to hold Quality of Service levels across every carrier route.","box":{"x":530,"y":3112,"w":640,"h":282},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/QsfB4yxrdWpq7KlhjgDrU5IFBw.png?scale-down-to=512&width=800&height=800","alt":"Kevin Huang, Founder of Vocom AI","box":{"x":270,"y":3459,"w":220,"h":220},"nat":[220,220]},{"t":"p","text":"Kevin Huang","box":{"x":530,"y":3434,"w":640,"h":29},"links":[]},{"t":"p","text":"Founder, Vocom AI","box":{"x":530,"y":3471,"w":640,"h":21},"links":[]},{"t":"p","text":"Kevin Huang is the founder of Vocom AI, the AI-focused division of Vocom International. He leads go-to-market and product strategy across a full-stack deployment model spanning GPU and AI server infrastructure, data center integration, and custom AI software, giving customers one accountable partner instead of three disconnected vendors. His background spans product management and sales across telecom and AI infrastructure. He is fluent in English and Mandarin and holds a degree from the University of Southern California’s Marshall School of Business.","box":{"x":530,"y":3499,"w":640,"h":205},"links":[]},{"t":"h3","text":"Our Products","box":{"x":410,"y":3864,"w":620,"h":58},"links":[]},{"t":"p","text":"A closer look at what each business line delivers.","box":{"x":410,"y":3932,"w":620,"h":31},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/5z4XORY5udhHiV6O1IVTtidmn20.jpg?scale-down-to=512&width=1920&height=1280","alt":"Fiber optic cable installation for Vocom wholesale supply","box":{"x":120,"y":4002,"w":384,"h":410},"nat":[384,255]},{"t":"p","text":"Fiber Optic Cable","box":{"x":160,"y":4291,"w":312,"h":31},"links":[]},{"t":"p","text":"Loose-tube, ribbon, ADSS, FTTH, and data-center cabling, built to order.","box":{"x":160,"y":4325,"w":312,"h":54},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/tUv2nIx3uYXWSTcwzHVGaalKtNY.jpg?scale-down-to=1024&width=1920&height=1280","alt":"Vocom AI Coach Hub interface for always-on sales training","box":{"x":528,"y":4002,"w":792,"h":410},"nat":[792,528]},{"t":"p","text":"Vocom AI Coach Hub","box":{"x":568,"y":4318,"w":720,"h":31},"links":[]},{"t":"p","text":"Always-on AI training that helps teams talk smarter and close faster.","box":{"x":568,"y":4353,"w":720,"h":27},"links":[]},{"t":"img","src":"https://framerusercontent.com/images/sSqgTmhiLX4qAmQx9iV673VVkpI.jpg?scale-down-to=1024&width=1920&height=1281","alt":"Vocom AI Secure video security a